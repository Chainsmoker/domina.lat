{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"name": "domina-lat",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{ "pattern": "domina.lat", "custom_domain": true },
		{ "pattern": "www.domina.lat", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	}
}