# Configuración pública de Sanity
PUBLIC_SANITY_PROJECT_ID=tu-project-id
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-08-01

# Token de API privado (opcional: solo si necesitas leer borradores/drafts o contenido privado)
SANITY_API_READ_TOKEN=tu_token_aqui

# Upstash Redis (Cache Layer)
UPSTASH_REDIS_REST_URL=https://tu-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token_redis_aqui

# Cloudflare (Deploy)
CLOUDFLARE_API_TOKEN=tu_token_cf_aqui
CLOUDFLARE_ACCOUNT_ID=tu_account_id_aqui

