---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { getPosts, getPostBySlug } from '../../lib/sanity/queries';
import { urlFor } from '../../lib/sanity/image';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { slug: post.slug }
  }));
}

const { slug } = Astro.props;
const post = await getPostBySlug(slug);

if (!post) {
  return Astro.redirect('/404');
}
import { formatTitle } from '../../lib/utils/formatTitle';

const allPosts = await getPosts();
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .slice(0, 3);
const cleanTitle = post.title.replace(/<[^>]*>/g, '');
const pageTitle = post.seoTitle || `${cleanTitle} | Domina`;
const pageDescription = post.seoDescription || post.dek || `Guía práctica sobre ${cleanTitle} en Domina.lat.`;
const pageImage = post.ogImage
  ? urlFor(post.ogImage).width(1200).url()
  : post.heroImage
  ? urlFor(post.heroImage).width(1200).url()
  : '/images/hero-manicure.webp';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": cleanTitle,
  "description": pageDescription,
  "image": pageImage,
  ...(post.publishedAt ? { "datePublished": post.publishedAt } : {}),
  "author": {
    "@type": "Person",
    "name": post.authorName || "Editorial Domina"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Domina",
    "logo": {
      "@type": "ImageObject",
      "url": "https://domina.lat/apple-touch-icon.png"
    }
  }
};
---

<Layout title={pageTitle} description={pageDescription} image={pageImage} type="article" jsonLd={jsonLd}>
  <main class="page-post">
    <header class="hero">
      <div class="container">
        <div class="breadcrumb">
          <a href="/guias">Guías</a> / {post.category?.title || 'General'} / <span set:html={post.title} />
        </div>
        <div class="hero-grid">
          <div>
            <span class="eyebrow">{post.eyebrow || post.category?.title || 'Guía práctica'}</span>
            <h1 class="display" set:html={formatTitle(post.title)} />
            {post.dek && <p class="dek">{post.dek}</p>}
            <div class="meta">
              {post.readingTime && <span>{post.readingTime}</span>}
              {post.publishedAt && (
                <>
                  <span>•</span>
                  <span>{new Date(post.publishedAt).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })}</span>
                </>
              )}
              {post.authorName && (
                <>
                  <span>•</span>
                  <span>Por {post.authorName.split('·')[0].trim()}</span>
                </>
              )}
            </div>
            {post.authorName && (
              <div class="author">
                <div class="avatar">
                  <img src={post.authorAvatar ? urlFor(post.authorAvatar).width(100).url() : '/images/sobre-aprendizaje.webp'} alt={post.authorName} />
                </div>
                <div>
                  <b>{post.authorName}</b>
                  {post.authorRole && (
                    <>
                      <br />
                      <span style="color:var(--muted)">{post.authorRole}</span>
                    </>
                  )}
                </div>
              </div>
            )}
          </div>
          <div class="hero-media">
            <img src={post.heroImage ? urlFor(post.heroImage).width(1000).url() : '/images/hero-manicure.webp'} alt={post.title.replace(/<[^>]*>/g, '')} />
            {post.heroBadge && <span class="hero-badge">{post.heroBadge}</span>}
          </div>
        </div>
      </div>
    </header>

    <section>
      <div class="container article-wrap">
        {post.toc && post.toc.length > 0 && (
          <aside class="toc">
            <strong>En esta guía</strong>
            {post.toc.map((item) => (
              <a href={`#${item.id}`}>{item.text}</a>
            ))}
          </aside>
        )}

        <article class="content">
          {post.body && post.body.length > 0 ? (
            post.body.map((block: any) => {
              if (block._type === 'block') {
                const text = block.children?.map((child: any) => child.text).join('') || '';
                const blockId = text.toLowerCase().replace(/[^a-z0-9]+/g, '-');
                if (block.style === 'h2') return <h2 id={blockId}>{text}</h2>;
                if (block.style === 'h3') return <h3>{text}</h3>;
                if (block.style === 'blockquote') return <p class="lead">{text}</p>;
                return <p>{text}</p>;
              }
              if (block._type === 'callout') {
                return (
                  <div class={`callout ${block.variant || 'cream'}`}>
                    {block.title && <h3>{block.title}</h3>}
                    {block.text && <p>{block.text}</p>}
                  </div>
                );
              }
              if (block._type === 'checklist') {
                return (
                  <div class="checklist">
                    {block.items?.map((item: any) => (
                      <div class="check">
                        <b>{item.bold}</b>
                        <span>{item.text}</span>
                      </div>
                    ))}
                  </div>
                );
              }
              if (block._type === 'tableBlock' && block.headers) {
                return (
                  <div class="table-box">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((h: string) => (
                            <th>{h}</th>
                          ))}
                        </tr>
                      </thead>
                      {block.rows && (
                        <tbody>
                          {block.rows.map((row: any) => (
                            <tr>
                              {row.cells?.map((cell: string) => (
                                <td>{cell}</td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      )}
                    </table>
                  </div>
                );
              }
              if (block._type === 'affiliateNotice') {
                return (
                  <div class="affiliate">
                    {block.text}
                  </div>
                );
              }
              if (block._type === 'image' && block.asset) {
                return (
                  <figure class="post-media-block">
                    <img src={urlFor(block).width(900).url()} alt={block.alt || post.title} />
                    {block.caption && <figcaption>{block.caption}</figcaption>}
                  </figure>
                );
              }
              return null;
            })
          ) : (
            <p class="lead">{post.dek}</p>
          )}

          <div class="share">
            <b>¿Te resultó útil?</b>
            <div class="share-buttons">
              <button id="copyBtn">Copiar enlace</button>
              <button>Facebook</button>
              <button>WhatsApp</button>
            </div>
          </div>

          {post.authorName && (
            <div class="author-box">
              <div class="avatar">
                <img src={post.authorAvatar ? urlFor(post.authorAvatar).width(120).url() : '/images/sobre-aprendizaje.webp'} alt={post.authorName} />
              </div>
              <div>
                <span class="eyebrow">Sobre el autor</span>
                <h3>{post.authorName}</h3>
                {post.authorRole && <p>{post.authorRole}</p>}
              </div>
            </div>
          )}
        </article>
      </div>
    </section>

    <!-- CURSO RELACIONADO FULL WIDTH CON RING DECORATIVO -->
    {post.relatedCourse && (
      <section class="related-course-section">
        <div class="container">
          <div class="course-cta-box">
            <div class="ring-decoration" aria-hidden="true">
              <svg width="520" height="520" viewBox="0 0 520 520" fill="none">
                <circle cx="400" cy="120" r="340" stroke="rgba(215, 255, 95, 0.12)" stroke-width="64"/>
                <circle cx="400" cy="120" r="230" stroke="rgba(215, 255, 95, 0.09)" stroke-width="44"/>
                <circle cx="400" cy="120" r="140" stroke="rgba(215, 255, 95, 0.06)" stroke-width="28"/>
              </svg>
            </div>
            <div class="cta-grid">
              <div class="cta-content">
                <span class="eyebrow-badge">✦ Curso Recomendado</span>
                <h2 class="cta-title">{post.relatedCourse.title}</h2>
                <p class="cta-desc">{post.relatedCourse.desc}</p>
                <div class="cta-action">
                  <a class="btn btn-acid" href={post.relatedCourse.link || '/cursos'}>
                    Ver análisis del curso ↗
                  </a>
                </div>
              </div>
              <div class="cta-media">
                <img src={post.relatedCourse.image ? urlFor(post.relatedCourse.image).width(700).url() : '/images/hero-manicure.webp'} alt={post.relatedCourse.title} />
                <span class="media-pill">Evaluación editorial ✦</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    {relatedPosts.length > 0 && (
      <section class="related">
        <div class="container">
          <div class="section-head">
            <div>
              <span class="eyebrow">Sigue aprendiendo</span>
              <h2 class="display">Guías relacionadas.</h2>
            </div>
            <a class="btn" href="/guias">Ver todas las guías</a>
          </div>
          <div class="grid">
            {relatedPosts.map((rel) => (
              <article class="post">
                <div class="media">
                  <img src={rel.heroImage ? urlFor(rel.heroImage).width(700).url() : '/images/hero-manicure.webp'} alt={rel.title} />
                </div>
                <div class="copy">
                  <small>{rel.category?.title || 'Guía'}</small>
                  <h3>
                    <a href={`/guias/${rel.slug}`}>{rel.title}</a>
                  </h3>
                  <p>{rel.dek}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</Layout>

<script>
  const copyBtn = document.getElementById('copyBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard?.writeText(window.location.href);
      copyBtn.textContent = 'Copiado ✓';
    });
  }
</script>

<style>
  .hero {
    padding: 48px 0 36px;
  }
  .breadcrumb {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 3.8vw, 3.6rem);
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin: 14px 0 18px 0;
  }
  .hero h1 span,
  .hero h1 :global(span) {
    color: var(--orange);
  }
  .dek {
    font-size: 1.12rem;
    line-height: 1.65;
    color: #4b5262;
    margin: 0 0 24px 0;
    max-width: 580px;
  }
  .meta {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    color: #7a8190;
    font-size: 0.9rem;
  }
  .author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
  }
  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-media {
    height: 460px;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: var(--shadow);
    position: relative;
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(11, 16, 32, 0.36),
      transparent 40%
    );
  }
  .hero-badge {
    position: absolute;
    left: 22px;
    bottom: 22px;
    background: var(--lime);
    padding: 10px 16px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.88rem;
    z-index: 2;
  }
  .article-wrap {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    align-items: start;
    padding: 56px 0 80px;
  }
  .toc {
    position: sticky;
    top: 100px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: #fff;
    padding: 22px 20px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
  }
  .toc strong {
    font: 800 0.82rem "Manrope", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 8px;
  }
  .toc a {
    display: block;
    padding: 8px 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.4;
    transition: color 0.15s ease;
  }
  .toc a:hover {
    color: var(--orange);
  }
  .content {
    font-size: 1.1rem;
    line-height: 1.82;
    color: #2b303c;
    max-width: 820px;
  }
  .content h2 {
    font: 800 clamp(1.8rem, 2.8vw, 2.3rem) / 1.15 "Manrope", sans-serif;
    letter-spacing: -0.035em;
    margin: 48px 0 18px;
    color: var(--ink);
  }
  .content h3 {
    font: 800 1.4rem / 1.25 "Manrope", sans-serif;
    letter-spacing: -0.02em;
    margin: 32px 0 12px;
    color: var(--ink);
  }
  .content p {
    margin: 0 0 22px;
  }
  .lead {
    font-size: 1.28rem;
    line-height: 1.7;
    color: #1e2430;
    font-weight: 500;
    margin-bottom: 28px !important;
  }
  .callout {
    border-radius: 26px;
    padding: 26px;
    margin: 30px 0;
  }
  .callout.orange {
    background: var(--orange);
    color: var(--ink);
  }
  .callout.cream {
    background: var(--cream);
  }
  .callout.dark {
    background: var(--ink);
    color: #fff;
  }
  .callout h3 {
    margin-top: 0;
  }
  .checklist {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 28px 0;
  }
  .check {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 16px;
    background: #fff;
  }
  .check b {
    display: block;
  }
  .affiliate {
    font-size: 0.9rem;
    color: var(--muted);
    border-left: 3px solid var(--orange);
    padding-left: 14px;
    margin: 30px 0;
  }

  /* TABLA CON HEADER #0b1020 Y RESALTADO NARANJA */
  .table-box {
    overflow-x: auto;
    border: 1px solid rgba(11, 16, 32, 0.12);
    border-radius: 20px;
    margin: 36px 0;
    background: #ffffff;
    box-shadow: 0 10px 30px rgba(11, 16, 32, 0.04);
  }
  .table-box table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
    text-align: left;
  }
  .table-box th {
    background: #0b1020;
    color: #ffffff;
    font: 800 0.84rem "Manrope", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 18px 20px;
    border-bottom: 3px solid var(--orange);
  }
  .table-box td {
    padding: 16px 20px;
    border-bottom: 1px solid rgba(11, 16, 32, 0.08);
    font-size: 0.96rem;
    color: #2b303c;
    line-height: 1.5;
  }
  .table-box tbody tr:nth-child(even) {
    background: #fbfbf9;
  }
  .table-box tbody tr:last-child td {
    border-bottom: none;
  }
  .table-box tbody tr:hover {
    background: rgba(215, 255, 95, 0.08);
  }
  .post-media-block {
    margin: 32px 0;
    border-radius: 22px;
    overflow: hidden;
  }
  .post-media-block img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 22px;
  }
  .post-media-block figcaption {
    font-size: 0.88rem;
    color: var(--muted);
    margin-top: 8px;
    text-align: center;
  }
  .share {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 22px 0;
    margin-top: 52px;
  }
  .share-buttons {
    display: flex;
    gap: 8px;
  }
  .share-buttons button {
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 999px;
    padding: 9px 13px;
    cursor: pointer;
  }
  .author-box {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 20px;
    background: var(--cream);
    border-radius: 26px;
    padding: 26px;
    margin-top: 34px;
  }
  .author-box .avatar {
    width: 90px;
    height: 90px;
  }

  /* FULL WIDTH RELATED COURSE CTA */
  .related-course-section {
    padding: 12px 0 64px;
  }
  .course-cta-box {
    background: var(--ink);
    color: #fff;
    border-radius: 32px;
    padding: 48px 56px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 48px rgba(11, 16, 32, 0.16);
  }
  .course-cta-box .ring-decoration {
    position: absolute;
    top: -120px;
    right: -80px;
    pointer-events: none;
    z-index: 1;
  }
  .cta-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .eyebrow-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(215, 255, 95, 0.15);
    color: var(--lime);
    border: 1px solid rgba(215, 255, 95, 0.3);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 18px;
  }
  .cta-title {
    font: 800 clamp(2rem, 3.2vw, 2.8rem) / 1.1 "Manrope", sans-serif;
    letter-spacing: -0.04em;
    margin: 0 0 16px 0;
    color: #fff;
  }
  .cta-desc {
    font-size: 1.08rem;
    line-height: 1.65;
    color: #c5cbd8;
    margin: 0 0 28px 0;
    max-width: 540px;
  }
  .btn-acid {
    background: var(--lime);
    color: var(--ink);
    border-color: var(--lime);
    font-weight: 800;
    padding: 16px 28px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .btn-acid:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(215, 255, 95, 0.3);
  }
  .cta-media {
    position: relative;
    height: 280px;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
  }
  .cta-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media-pill {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: rgba(11, 16, 32, 0.85);
    color: #fff;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }

  .related {
    padding: 88px 0;
    background: var(--cream);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 28px;
    margin-bottom: 28px;
  }
  .section-head h2 {
    font-size: clamp(3rem, 6vw, 6rem);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .post {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 24px;
    overflow: hidden;
  }
  .post .media {
    height: 210px;
    overflow: hidden;
  }
  .post .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post .copy {
    padding: 20px;
  }
  .post h3 {
    font: 800 1.35rem / 1.15 "Manrope", sans-serif;
    margin: 10px 0;
  }
  .post p {
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 1040px) {
    .article-wrap {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .hero-media {
      height: 380px;
    }
    .toc {
      position: static;
    }
  }
  @media (max-width: 900px) {
    .course-cta-box {
      padding: 36px 28px;
    }
    .cta-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .cta-media {
      height: 220px;
    }
  }
  @media (max-width: 760px) {
    .hero {
      padding-top: 32px;
    }
    .hero h1 {
      font-size: 2.2rem;
    }
    .hero-media {
      height: 300px;
    }
    .article-wrap {
      padding-top: 32px;
    }
    .checklist,
    .grid {
      grid-template-columns: 1fr;
    }
    .author-box {
      grid-template-columns: 1fr;
    }
    .section-head {
      display: block;
    }
  }
</style>
