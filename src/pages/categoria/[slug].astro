---
export const prerender = false;
import CategoriaPage from '../categoria.astro';
import { getCategoryBySlug } from '../../lib/sanity/queries';

const { slug } = Astro.params;
const category = slug ? await getCategoryBySlug(slug) : null;

if (!category) {
  return Astro.redirect('/404');
}
---

<CategoriaPage category={category} />
