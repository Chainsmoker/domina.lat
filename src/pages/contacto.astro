---
import Layout from '../layouts/Layout.astro';

const reasons = [
  { id: 'r1', value: 'consulta', title: 'Tengo una consulta', desc: 'Dudas generales sobre Domina o un curso.', checked: true },
  { id: 'r2', value: 'sugerencia', title: 'Quiero sugerir', desc: 'Un curso, categoría o mejora para la plataforma.', checked: false },
  { id: 'r3', value: 'alianza', title: 'Soy creador/a', desc: 'Quiero presentar una formación o colaborar.', checked: false },
];

const faqs = [
  { q: '¿Domina crea todos los cursos?', a: 'No necesariamente. Domina selecciona, organiza y recomienda formaciones de distintos creadores. Cada página debe indicar claramente quién imparte el curso y dónde se realiza la compra.' },
  { q: '¿Puedo proponer mi curso para aparecer en Domina?', a: 'Sí. Puedes usar el formulario y elegir “Soy creador/a”. Revisaremos la propuesta considerando claridad, aplicación práctica, calidad del contenido y ajuste con las categorías de la plataforma.' },
  { q: '¿Domina garantiza resultados o ingresos?', a: 'No. Aprender una habilidad puede abrir oportunidades, pero los resultados dependen del curso, la práctica, el mercado y las decisiones de cada persona.' },
  { q: '¿Cómo reporto un enlace o información incorrecta?', a: 'Selecciona “Problema con un enlace” en el formulario e incluye la URL o el nombre del curso. Eso permite revisar el contenido con rapidez.' }
];
---

<Layout title="Contacto | Domina" description="Habla con Domina para sugerir cursos, resolver dudas o proponer colaboraciones.">
  <main class="page-contacto">
    <header class="hero">
      <div class="container hero-grid">
        <div>
          <span class="eyebrow">Contacto directo</span>
          <h1 class="display">Hablemos.<span>Estamos aquí.</span></h1>
          <p>Escríbenos para sugerir una categoría, preguntar por una recomendación, proponer una colaboración o contarnos qué habilidad quieres encontrar en Domina.</p>
          <div class="hero-note">
            <span class="pulse"></span>
            <span>Respondemos normalmente en 1–2 días hábiles.</span>
          </div>
        </div>
        <div class="contact-art">
          <div class="art-main">
            <img src="/images/contacto-colaboracion.webp" alt="Personas colaborando y aprendiendo" />
          </div>
          <div class="floating">Sin respuestas automáticas vacías ✦</div>
          <div class="art-card">
            <strong>Tu mensaje puede mejorar Domina.</strong>
            <p>Leemos sugerencias de alumnos, creadores y personas que quieren comenzar.</p>
          </div>
        </div>
      </div>
    </header>

    <section class="contact-section">
      <div class="container contact-grid">
        <aside class="side">
          <span class="eyebrow">Contacto directo</span>
          <h2>Elige la vía que tenga sentido.</h2>
          <p>No necesitas redactar un correo perfecto. Cuéntanos brevemente qué necesitas y te dirigiremos al lugar correcto.</p>
          <div class="channels">
            <a class="channel" href="mailto:hola@domina.lat">
              <i>@</i>
              <div>
                <strong>Correo general</strong>
                <span>hola@domina.lat</span>
              </div>
            </a>
            <a class="channel" href="#formulario">
              <i>+</i>
              <div>
                <strong>Sugerir un curso</strong>
                <span>Cuéntanos qué te gustaría aprender</span>
              </div>
            </a>
            <a class="channel" href="#formulario">
              <i>↗</i>
              <div>
                <strong>Creadores y alianzas</strong>
                <span>Presenta tu curso o propuesta</span>
              </div>
            </a>
          </div>
          <div class="hours">
            Atención digital · Lunes a viernes<br />Horario de referencia: 9:00–18:00 (UTC)
          </div>
        </aside>

        <div class="form-shell" id="formulario">
          <div class="form-head">
            <div>
              <span class="eyebrow">Cuéntanos</span>
              <h2>¿En qué podemos ayudarte?</h2>
            </div>
            <span>Formulario de 2 minutos</span>
          </div>
          <form id="contactForm" novalidate>
            <div class="reason-grid">
              {reasons.map((r) => (
                <div class="reason">
                  <input type="radio" id={r.id} name="motivo" value={r.value} checked={r.checked} />
                  <label for={r.id}>
                    <strong>{r.title}</strong>
                    <span>{r.desc}</span>
                  </label>
                </div>
              ))}
            </div>
            <div class="fields">
              <div class="field">
                <label for="name">Nombre</label>
                <input id="name" name="name" type="text" placeholder="Tu nombre completo" required />
                <span class="field-error" id="error-name"></span>
              </div>
              <div class="field">
                <label for="email">Correo electrónico</label>
                <input id="email" name="email" type="email" placeholder="tu@correo.com" required />
                <span class="field-error" id="error-email"></span>
              </div>
              <div class="field full">
                <label for="topic">Tema</label>
                <select id="topic" name="topic">
                  <option>Información sobre cursos</option>
                  <option>Sugerencia de categoría</option>
                  <option>Problema con un enlace</option>
                  <option>Presentar mi curso</option>
                  <option>Alianza comercial</option>
                  <option>Otro</option>
                </select>
              </div>
              <div class="field full">
                <label for="message">Mensaje</label>
                <textarea id="message" name="message" placeholder="Cuéntanos lo necesario para entender tu consulta (mínimo 10 caracteres)…" required></textarea>
                <span class="field-error" id="error-message"></span>
              </div>
            </div>
            <div class="form-foot">
              <p>Al enviar aceptas que usemos estos datos únicamente para responder tu mensaje. Domina no vende información personal.</p>
              <button class="btn btn-dark submit" type="submit" id="submitBtn">
                <span class="btn-text">Enviar mensaje ↗</span>
                <span class="btn-spinner" style="display:none">
                  <svg class="spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="10"/></svg>
                  Enviando...
                </span>
              </button>
            </div>
            <div class="alert-box success-box" id="successBox" style="display:none">
              ¡Tu mensaje ha sido enviado con éxito! Te responderemos a la brevedad.
            </div>
            <div class="alert-box error-box" id="globalErrorBox" style="display:none">
            </div>
          </form>
        </div>
      </div>
    </section>

    <section class="faq">
      <div class="container faq-grid">
        <div>
          <span class="eyebrow">Antes de escribir</span>
          <h2 class="display">Preguntas rápidas.</h2>
          <p>Estas respuestas evitan esperas y aclaran cómo funciona Domina como plataforma de selección y recomendación.</p>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}<span>+</span></summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const btnText = submitBtn?.querySelector('.btn-text') as HTMLElement | null;
  const btnSpinner = submitBtn?.querySelector('.btn-spinner') as HTMLElement | null;
  const successBox = document.getElementById('successBox') as HTMLElement | null;
  const globalErrorBox = document.getElementById('globalErrorBox') as HTMLElement | null;

  function clearErrors() {
    document.querySelectorAll('.field-error').forEach((el) => (el.textContent = ''));
    if (globalErrorBox) {
      globalErrorBox.style.display = 'none';
      globalErrorBox.textContent = '';
    }
    if (successBox) successBox.style.display = 'none';
  }

  function validateEmail(email: string) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim());
  }

  if (form && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();

      const nameInput = document.getElementById('name') as HTMLInputElement;
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const topicInput = document.getElementById('topic') as HTMLSelectElement;
      const messageInput = document.getElementById('message') as HTMLTextAreaElement;

      const nameErrorEl = document.getElementById('error-name');
      const emailErrorEl = document.getElementById('error-email');
      const messageErrorEl = document.getElementById('error-message');

      let hasError = false;

      if (!nameInput.value.trim() || nameInput.value.trim().length < 2) {
        if (nameErrorEl) nameErrorEl.textContent = 'Por favor ingresa tu nombre (mínimo 2 caracteres).';
        hasError = true;
      }

      if (!validateEmail(emailInput.value)) {
        if (emailErrorEl) emailErrorEl.textContent = 'Por favor ingresa un correo electrónico válido.';
        hasError = true;
      }

      if (!messageInput.value.trim() || messageInput.value.trim().length < 10) {
        if (messageErrorEl) messageErrorEl.textContent = 'El mensaje debe tener al menos 10 caracteres.';
        hasError = true;
      }

      if (hasError) return;

      // Estado de envío / Spinner + Disabled
      submitBtn.disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (btnSpinner) btnSpinner.style.display = 'inline-flex';

      try {
        const response = await fetch('/api/contacto', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: nameInput.value.trim(),
            email: emailInput.value.trim(),
            subject: topicInput.value,
            message: messageInput.value.trim(),
          }),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          if (successBox) {
            successBox.textContent = result.message || '¡Tu mensaje ha sido enviado con éxito!';
            successBox.style.display = 'block';
          }
          form.reset();
        } else {
          if (result.errors) {
            if (result.errors.name && nameErrorEl) nameErrorEl.textContent = result.errors.name;
            if (result.errors.email && emailErrorEl) emailErrorEl.textContent = result.errors.email;
            if (result.errors.message && messageErrorEl) messageErrorEl.textContent = result.errors.message;
          }
          if (globalErrorBox) {
            globalErrorBox.textContent = result.message || 'Error al enviar. Revisa los campos requeridos.';
            globalErrorBox.style.display = 'block';
          }
        }
      } catch (err) {
        if (globalErrorBox) {
          globalErrorBox.textContent = 'Ocurrió un problema de conexión. Inténtalo de nuevo.';
          globalErrorBox.style.display = 'block';
        }
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.style.display = 'inline';
        if (btnSpinner) btnSpinner.style.display = 'none';
      }
    });
  }
</script>

<style>
  .page-contacto .hero {
    padding: 72px 0 50px;
    overflow: hidden;
  }
  .page-contacto .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .page-contacto .hero h1 {
    font-size: clamp(4rem, 7.6vw, 7.8rem);
    max-width: 820px;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .page-contacto .hero h1 span {
    display: block;
    color: var(--orange);
  }
  .page-contacto .hero p {
    font-size: 1.14rem;
    line-height: 1.72;
    color: #535a6a;
    max-width: 620px;
    margin: 24px 0 0;
  }
  .hero-note {
    margin-top: 28px;
    display: flex;
    gap: 14px;
    align-items: center;
    color: #596071;
  }
  .pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 8px rgba(215, 255, 95, 0.28);
  }
  .contact-art {
    position: relative;
    width: 100%;
    min-height: 440px;
    display: flex;
    align-items: center;
  }
  .art-main {
    width: 100%;
    height: 380px;
    border-radius: 30px;
    overflow: hidden;
    background: var(--violet);
    box-shadow: var(--shadow);
    position: relative;
  }
  .art-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .art-main::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 16, 32, 0.45), transparent 60%);
  }
  .art-card {
    position: absolute;
    left: -12px;
    bottom: 0;
    width: 72%;
    background: var(--lime);
    padding: 22px 24px;
    border-radius: 26px;
    transform: rotate(-2deg);
    box-shadow: var(--shadow);
    border: 1px solid rgba(0, 0, 0, 0.05);
    z-index: 2;
  }
  .art-card strong {
    font: 800 1.45rem / 1.12 "Manrope", sans-serif;
    letter-spacing: -0.035em;
    display: block;
    color: var(--ink);
  }
  .art-card p {
    font-size: 0.88rem;
    line-height: 1.45;
    color: #2b3240;
    margin: 6px 0 0;
  }
  .floating {
    position: absolute;
    right: 0;
    top: 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 10px 18px;
    font-weight: 800;
    font-size: 0.84rem;
    transform: rotate(2deg);
    box-shadow: 0 12px 28px rgba(11, 16, 32, 0.12);
    z-index: 3;
  }

  .contact-section {
    padding: 76px 0 100px;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: 20px;
    align-items: start;
  }
  .side {
    background: var(--ink);
    color: #fff;
    border-radius: 32px;
    padding: 32px;
    position: sticky;
    top: 104px;
  }
  .side h2 {
    font: 800 clamp(2.7rem, 5vw, 5.4rem) / 0.96 "Manrope", sans-serif;
    letter-spacing: -0.055em;
    margin: 0;
  }
  .side > p {
    color: #bdc3cf;
    line-height: 1.7;
  }
  .channels {
    display: grid;
    gap: 12px;
    margin-top: 30px;
  }
  .channel {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 13px;
    align-items: center;
    background: #171f34;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 15px;
    text-decoration: none;
    color: inherit;
  }
  .channel i {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: var(--orange);
    display: grid;
    place-items: center;
    color: var(--ink);
    font-style: normal;
    font-weight: 900;
  }
  .channel:nth-child(2) i {
    background: var(--lime);
  }
  .channel:nth-child(3) i {
    background: var(--violet);
  }
  .channel strong {
    display: block;
    font: 800 1rem "Manrope", sans-serif;
  }
  .channel span {
    font-size: 0.88rem;
    color: #aeb5c6;
  }
  .hours {
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.9rem;
    color: #aeb5c6;
  }
  .form-shell {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 32px;
    padding: 32px;
    box-shadow: 0 18px 50px rgba(11, 16, 32, 0.07);
  }
  .form-head {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: flex-start;
    margin-bottom: 26px;
  }
  .form-head h2 {
    font: 800 clamp(2.3rem, 4vw, 4.4rem) / 1 "Manrope", sans-serif;
    letter-spacing: -0.05em;
    margin: 0;
  }
  .form-head span {
    background: var(--cream);
    border-radius: 999px;
    padding: 9px 12px;
    font-size: 0.78rem;
    font-weight: 800;
    white-space: nowrap;
  }
  .reason-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 24px;
  }
  .reason {
    position: relative;
  }
  .reason input {
    position: absolute;
    opacity: 0;
  }
  .reason label {
    display: block;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 18px;
    cursor: pointer;
    min-height: 96px;
    transition: 0.2s;
  }
  .reason label strong {
    display: block;
    font: 800 1rem "Manrope", sans-serif;
  }
  .reason label span {
    display: block;
    color: var(--muted);
    font-size: 0.84rem;
    margin-top: 6px;
    line-height: 1.35;
  }
  .reason input:checked + label {
    background: var(--lime);
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .field {
    display: grid;
    gap: 6px;
  }
  .field.full {
    grid-column: 1 / -1;
  }
  .field label {
    font-weight: 800;
    font-size: 0.9rem;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--paper);
    border-radius: 16px;
    padding: 14px 16px;
    outline: none;
    font: inherit;
    transition: 0.2s;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--orange);
    box-shadow: 0 0 0 4px rgba(255, 92, 53, 0.1);
  }
  .field textarea {
    min-height: 140px;
    resize: vertical;
  }
  .field-error {
    color: #e53935;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .form-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 20px;
  }
  .form-foot p {
    font-size: 0.82rem;
    color: var(--muted);
    max-width: 430px;
    margin: 0;
  }
  .submit {
    min-width: 190px;
    position: relative;
  }
  .submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
  .btn-spinner {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .spinner {
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .alert-box {
    margin-top: 18px;
    padding: 15px 18px;
    border-radius: 16px;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .success-box {
    background: var(--mint);
    border: 1px solid rgba(11, 16, 32, 0.14);
    color: var(--ink);
  }
  .error-box {
    background: #ffebee;
    border: 1px solid #ffcdd2;
    color: #c62828;
  }

  .faq {
    padding: 96px 0;
    background: var(--cream);
  }
  .faq-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 50px;
  }
  .faq h2 {
    font-size: clamp(3rem, 6vw, 6.2rem);
  }
  .faq p {
    color: var(--muted);
    line-height: 1.7;
  }
  .faq-list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
    padding: 0;
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 22px 0;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font: 800 1.1rem "Manrope", sans-serif;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    transition: 0.2s;
  }
  details[open] summary span {
    transform: rotate(45deg);
    background: var(--orange);
  }
  details p {
    margin: 0 0 22px;
    max-width: 760px;
    line-height: 1.7;
    animation: faqSlide 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes faqSlide {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1050px) {
    .page-contacto .hero-grid,
    .contact-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .contact-art {
      min-height: 500px;
    }
    .side {
      position: static;
    }
  }

  @media (max-width: 720px) {
    .page-contacto .hero {
      padding-top: 42px;
    }
    .page-contacto .hero h1 {
      font-size: clamp(3.7rem, 17vw, 5.4rem);
    }
    .contact-art {
      min-height: 400px;
    }
    .art-main {
      inset: 20px 0 62px 16px;
    }
    .art-card {
      width: 78%;
    }
    .form-shell,
    .side {
      padding: 23px;
    }
    .reason-grid,
    .fields {
      grid-template-columns: 1fr;
    }
    .field.full {
      grid-column: auto;
    }
    .form-head,
    .form-foot {
      flex-direction: column;
      align-items: stretch;
    }
    .submit {
      width: 100%;
    }
  }
</style>
