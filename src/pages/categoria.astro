  .guide {
    padding: 95px 0;
  }
  .guide-grid {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 48px;
    align-items: start;
  }
  .guide h2 {
    font-size: clamp(3.5rem, 6vw, 6.5rem);
    font-family: "Manrope", sans-serif;
    font-weight: 800;
