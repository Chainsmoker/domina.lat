  }
  .guide-card .copy {
    padding: 20px;
  }
  .guide-card small {
    text-transform: uppercase;
    letter-spacing: .09em;
    color: var(--orange);
    font-weight: 800;
  }
  .guide-card h3 {
    font: 800 1.25rem / 1.18 "Manrope", sans-serif;
    margin: 8px 0;
    color: var(--ink);
  }
  .guide-card p {
    font-size: .9rem;
    line-height: 1.5;
    margin: 0;
    color: #555C6C;
  }

  .trust {
    padding: 90px 0;
    background: var(--ink);
    color: #fff;
  }
  .trust-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .trust h2 {
    font-size: clamp(3.5rem, 6vw, 6.4rem);
    font-family: "Manrope", sans-serif;
    font-weight: 800;
    letter-spacing: -.055em;
    line-height: .94;
    margin: 0 0 16px;
    color: #fff;
  }
  .trust p {
    color: #BAC0CC;
    line-height: 1.7;
  }
  .checks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .check {
    background: #171E32;
    border: 1px solid rgba(255, 255, 255, .08);
    border-radius: 21px;
    padding: 21px;
  }
  .check b {
    font: 800 1.05rem "Manrope", sans-serif;
    display: block;
    color: #fff;
  }
  .check p {
    font-size: .88rem;
    margin: 8px 0 0;
    color: #BAC0CC;
  }

  @media (max-width: 1050px) {
    .hero-card {
      padding: 48px 36px;
    }
    .hero-content {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .hero-visual {
      display: none;
    }
    .subgrid {
      grid-template-columns: repeat(3, 1fr);
    }
    .course-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .feature {
      grid-column: span 2;
    }
    .guide-grid, .trust-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .hero-card {
      padding: 36px 24px;
      border-radius: 28px;
    }
    .hero h1 {
      font-size: clamp(2.2rem, 8.5vw, 3.4rem);
    }
    .hero-actions {
      flex-direction: column;
    }
    .btn-dark, .btn-soft {
      text-align: center;
      width: 100%;
    }
    .section-head, .course-toolbar {
      align-items: flex-start;
      flex-direction: column;
    }
    .subgrid {
      grid-template-columns: 1fr 1fr;
    }
    .course-grid {
      grid-template-columns: 1fr;
    }
    .feature {
      grid-column: auto;
      display: flex;
      flex-direction: column;
    }
    .feature .media {
      min-height: 250px;
    }
    .feature h3 {
      font-size: 1.55rem;
    }
    .guide-card {
      grid-template-columns: 110px 1fr;
    }
    .checks {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const initCategoryInteractions = () => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    const cards = [...document.querySelectorAll<HTMLElement>('#courseGrid .card')];
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((button) => {
          const active = button === btn;
          button.classList.toggle('active', active);
          button.setAttribute('aria-pressed', String(active));
        });
        const type = btn.dataset.filter || 'todos';
        cards.forEach((card) => {
          const cardTypes = card.dataset.type || '';
          card.hidden = type !== 'todos' && !cardTypes.split(' ').includes(type);
        });
      });
    });
    document.querySelectorAll<HTMLButtonElement>('.save').forEach((btn) => {
      btn.addEventListener('click', () => {
        const saved = btn.textContent === '♥';
        btn.textContent = saved ? '♡' : '♥';
        btn.setAttribute('aria-pressed', String(!saved));
      });
    });
  };

  initCategoryInteractions();
</script>
