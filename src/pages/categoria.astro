---
import Layout from '../layouts/Layout.astro';
import { getPosts, getCoursesByCategory, getCourses, getCategoryBySlug } from '../lib/sanity/queries';
import { urlFor } from '../lib/sanity/image';
import { formatTitle } from '../lib/utils/formatTitle';
import { formatPrice } from '../lib/utils/formatPrice';

const { category } = Astro.props;

// Edge Cache: 60s browser, 5min Cloudflare CDN hit
Astro.response.headers.set(
  'cache-control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=86400'
);

// Obtener información de la categoría y sus cursos desde Sanity
const categorySlug = category?.slug || 'belleza-y-unas';
const sanityCategory = (await getCategoryBySlug(categorySlug)) || category;

const categoryTitle = sanityCategory?.title || sanityCategory?.cardTitle || 'Belleza & uñas';
const categoryEyebrow = sanityCategory?.eyebrow || 'Categoría destacada';
const categoryDesc = sanityCategory?.description || 'Formaciones seleccionadas para aprender técnicas de manicure, pestañas, maquillaje y servicios de belleza con una mirada práctica: qué aprenderás, qué necesitas y cómo aplicar la habilidad.';

// Cursos de esta categoría desde Sanity
const displayCourses = await getCoursesByCategory(categorySlug);

// Guías relacionadas desde Sanity
const allPosts = await getPosts();
const displayGuides = allPosts.filter(p => 
  p.category?.slug === categorySlug || 
  p.category?.title?.toLowerCase().includes(categoryTitle.toLowerCase())
);

const categoryKey = `${categoryTitle} ${categorySlug}`.toLowerCase();
const categoryType = categoryKey.includes('uñ') || categoryKey.includes('belleza')
  ? 'unas'
  : categoryKey.includes('pastel') || categoryKey.includes('cocina')
    ? 'pasteleria'
    : categoryKey.includes('digital') || categoryKey.includes('ia')
      ? 'digital'
      : categoryKey.includes('oficio') || categoryKey.includes('repar')
        ? 'oficios'
        : 'general';

const cardStyleColorMap: Record<string, string> = {
  'card-orange': '#FF8A65',
  'card-lime': 'var(--lime)',
  'card-violet': 'var(--violet)',
  'card-mint': 'var(--mint)',
  'card-pink': 'var(--pink)',
};

const categoryTypeColorMap: Record<string, string> = {
  unas: 'var(--pink)',
  pasteleria: '#FF9EAA',
  digital: 'var(--violet)',
  oficios: 'var(--lime)',
  general: '#FF8A65',
};

const categoryColor =
  sanityCategory?.color ||
  (sanityCategory?.cardStyle && cardStyleColorMap[sanityCategory.cardStyle]) ||
  categoryTypeColorMap[categoryType] ||
  'var(--pink)';

const categoryFiltersMap: Record<string, Array<{ id: string; label: string }>> = {
  unas: [
    { id: 'todos', label: 'Todos' },
    { id: 'unas', label: 'Uñas' },
    { id: 'pestanas', label: 'Pestañas' },
    { id: 'maquillaje', label: 'Maquillaje' },
    { id: 'negocio', label: 'Para emprender' },
  ],
  pasteleria: [
    { id: 'todos', label: 'Todos' },
    { id: 'pasteleria', label: 'Pastelería' },
    { id: 'postres', label: 'Postres' },
    { id: 'negocio', label: 'Para emprender' },
  ],
  digital: [
    { id: 'todos', label: 'Todos' },
    { id: 'digital', label: 'Digital' },
    { id: 'ia', label: 'IA' },
    { id: 'negocio', label: 'Para emprender' },
  ],
  oficios: [
    { id: 'todos', label: 'Todos' },
    { id: 'oficios', label: 'Oficios' },
    { id: 'reparacion', label: 'Reparación' },
    { id: 'negocio', label: 'Para emprender' },
  ],
};

const categoryFilters = categoryFiltersMap[categoryType] || [
  { id: 'todos', label: 'Todos' },
  { id: 'negocio', label: 'Para emprender' },
];

const filterKeywords: Record<string, string[]> = {
  unas: ['uñ', 'belleza', 'manicure', 'pestaña', 'ceja', 'maquillaje'],
  pestanas: ['pestaña', 'ceja'],
  maquillaje: ['maquillaje'],
  pasteleria: ['pastel', 'postre', 'receta', 'cocina'],
  postres: ['postre', 'receta'],
  digital: ['digital', 'ia', 'chatgpt', 'automatiz'],
  ia: ['ia', 'chatgpt', 'inteligencia'],
  oficios: ['oficio', 'celular', 'repar', 'tecnic'],
  reparacion: ['repar', 'celular', 'mantenim'],
  negocio: ['emprend', 'negocio', 'vender', 'servicio'],
};

function courseTypes(course: (typeof displayCourses)[number]) {
  const text = `${course.title} ${course.dek || ''} ${course.category?.title || ''}`.toLowerCase();
  return Object.entries(filterKeywords)
    .filter(([, keywords]) => keywords.some((keyword) => text.includes(keyword)))
    .map(([type]) => type)
    .join(' ');
}

// Mantiene cinco entradas visuales del template de referencia, adaptadas a cada categoría.
const subcategories = [
  { 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/></svg>`, 
    title: categoryType === 'unas' ? 'Uñas profesionales' : `${categoryTitle.split(' ')[0]} inicial`, 
    text: `${displayCourses.length} cursos seleccionados` 
  },
  { 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`, 
    title: categoryType === 'unas' ? 'Pestañas y cejas' : 'Técnicas esenciales', 
    text: categoryType === 'unas' ? '8 cursos seleccionados' : 'Paso a paso guiado' 
  },
  { 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"/></svg>`, 
    title: categoryType === 'unas' ? 'Maquillaje' : 'Para emprender', 
    text: categoryType === 'unas' ? '11 cursos seleccionados' : 'Rutas prácticas' 
  },
  { 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>`, 
    title: categoryType === 'unas' ? 'Negocio de belleza' : 'Servicios comerciales', 
    text: categoryType === 'unas' ? '7 rutas para emprender' : 'Primeros clientes' 
  },
  { 
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`, 
    title: 'Guías para empezar', 
    text: 'Comparativas y recursos' 
  },
];

const heroImg = sanityCategory?.image 
  ? urlFor(sanityCategory.image).width(1300).url() 
  : '/images/hero-manicure.webp';
---

<Layout title={`${categoryTitle} | Cursos y Guías Domina`} description={categoryDesc}>
  <main class="page-categoria-exact">
    <div class="container crumbs">
      <a href="/">Inicio</a> / <a href="/cursos">Categorías</a> / <span>{categoryTitle}</span>
    </div>

    <header class="hero">
      <div class="container">
        <div class="hero-card" style={`--cat-accent: ${categoryColor};`}>
          <div class="hero-bg-shapes" aria-hidden="true">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
          </div>

          <div class="hero-content">
            <div class="hero-copy">
              <span class="eyebrow">{categoryEyebrow}</span>
              <h1 class="display" set:html={formatTitle(categoryTitle)} />
              <p>{categoryDesc}</p>
              <div class="hero-actions">
                <a class="btn btn-dark" href="#cursos">Explorar todos los cursos ↗</a>
                <a class="btn btn-soft" href="#guias">Leer guías ↗</a>
              </div>
            </div>

            {heroImg && (
              <div class="hero-visual">
                <div class="media-frame">
                  <img src={heroImg} alt={categoryTitle} />
                </div>
                <div class="hero-badge">
                  <small>Ruta consultada</small>
                  <strong>Aprende desde cero</strong>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </header>

    <section class="subcats">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Explora la categoría</span>
            <h2 class="display">Encuentra tu punto de entrada.</h2>
          </div>
          <p>Elige una especialidad según la habilidad que quieres aprender o el servicio que te interesa ofrecer.</p>
        </div>

        <div class="subgrid">
          {subcategories.map((sub) => (
            <a class="subcard" href={sub.title === 'Guías para empezar' ? '#guias' : '#cursos'}>
              <span class="subicon" set:html={sub.svg} />
              <div>
                <strong>{sub.title}</strong>
                <span>{sub.text}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="courses" id="cursos">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Cursos de la categoría</span>
            <h2 class="display">Aprende con una ruta clara.</h2>
          </div>
          <p>Compara nivel, enfoque, formato y recursos antes de elegir. Los precios y condiciones finales se confirman en la plataforma del creador.</p>
        </div>

        <div class="course-toolbar">
          <div class="filters">
            {categoryFilters.map((f, i) => (
              <button
                type="button"
                class={`filter ${i === 0 ? 'active' : ''}`}
                data-filter={f.id}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {f.label}
              </button>
            ))}
          </div>
        </div>

        {displayCourses.length > 0 ? (
          <div class="course-grid" id="courseGrid">
            {displayCourses.map((c, idx) => {
              const isFeature = idx === 0;
              const img = c.heroImage ? urlFor(c.heroImage).width(1200).url() : '/images/hero-manicure.webp';
              const rawTitle = c.title.replace(/<[^>]*>/g, '');
              const defaultFacts = ['Acceso online', 'Paso a paso', 'Certificado'];
              const courseFacts = c.facts && c.facts.length > 0 ? c.facts : defaultFacts;

              return (
                <article class={`card ${isFeature ? 'feature' : ''}`} data-type={courseTypes(c)}>
                  <div class="media">
                    <span class="badge">{c.resourceType || c.eyebrow || (isFeature ? 'Curso destacado' : 'Video curso')}</span>
                    <button class="save" aria-label="Guardar curso">♡</button>
                    <img src={img} alt={rawTitle} />
                  </div>
                  <div class="body">
                    <div class="meta">{c.category?.title || categoryTitle}</div>
                    <h3>{rawTitle}</h3>
                    <p class="desc">{c.dek || 'Formación práctica explicada paso a paso.'}</p>
                    <div class="facts">
                      {courseFacts.map((f: string) => (
                        <span class="fact">{f}</span>
                      ))}
                    </div>
                    <div class="card-foot">
                      <div class="price">
                        <small>Desde</small>
                        <strong>{formatPrice(c.price) || '$39'}</strong>
                      </div>
                      <a class="link" href={`/cursos/${c.slug}`}>{isFeature ? 'Ver análisis completo ↗' : 'Ver análisis ↗'}</a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="empty-state-card">
            <div class="empty-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
            </div>
            <h3>Próximamente cursos en {categoryTitle}</h3>
            <p>Estamos evaluando las mejores formaciones de esta categoría para publicarlas pronto.</p>
            <a href="/cursos" class="btn btn-acid">Explorar otros cursos ↗</a>
          </div>
        )}

        <div class="courses-more-wrap">
          <a class="btn btn-dark btn-more-courses" href={`/cursos?categoria=${categorySlug}#catalogo`}>
            Ver más cursos de {categoryTitle} ↗
          </a>
        </div>
      </div>
    </section>

    {displayGuides.length > 0 && (
      <section class="guide" id="guias">
        <div class="container guide-grid">
          <div>
            <span class="eyebrow">Antes de elegir</span>
            <h2 class="display">Aprende también a decidir.</h2>
            <p>Las guías de Domina ayudan a entender herramientas, costos iniciales, diferencias entre técnicas y criterios para comparar cursos sin depender únicamente de una página de ventas.</p>
            <a class="btn btn-dark" href="/guias">Ver todas las guías ↗</a>
          </div>
          <div class="guide-list">
            {displayGuides.map((g) => (
              <a class="guide-card" href={`/guias/${g.slug}`}>
                <div class="thumb">
                  <img src={g.heroImage ? urlFor(g.heroImage).width(600).url() : '/images/hero-manicure.webp'} alt={g.title.replace(/<[^>]*>/g, '')} />
                </div>
                <div class="copy">
                  <small>{g.category?.title || g.eyebrow || 'Guía'}</small>
                  <h3>{g.title.replace(/<[^>]*>/g, '')}</h3>
                  <p>{g.dek || ''}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="trust">
      <div class="container trust-grid">
        <div>
          <span class="eyebrow">Criterio editorial</span>
          <h2 class="display">Aprendizaje real. Promesas vacías, no.</h2>
          <p>Domina puede recibir una comisión por algunas recomendaciones, pero eso no cambia el precio para el usuario. La ficha de cada curso explica quién lo crea, qué incluye y qué puntos conviene revisar antes de comprar.</p>
        </div>
        <div class="checks">
          <div class="check">
            <b>Aplicación real</b>
            <p>La formación debe enseñar una técnica concreta y practicable.</p>
          </div>
          <div class="check">
            <b>Bioseguridad</b>
            <p>Priorizamos cursos que explican higiene y trabajo responsable.</p>
          </div>
          <div class="check">
            <b>Nivel claro</b>
            <p>Indicamos si el contenido sirve para comenzar o perfeccionarse.</p>
          </div>
          <div class="check">
            <b>Transparencia</b>
            <p>Mostramos límites, creador, formato y posibles enlaces afiliados.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .container {
    width: min(1280px, calc(100% - 36px));
  }

  .crumbs {
    padding-top: 24px;
    color: var(--muted);
    font-size: .88rem;
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  .crumbs span {
    color: var(--ink);
    font-weight: 700;
  }

  .hero {
    padding: 24px 0 60px;
  }
  .hero-card {
    position: relative;
    background: var(--cat-accent, var(--pink));
    color: var(--ink);
    border-radius: 36px;
    padding: 64px 68px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(11, 16, 32, 0.08);
  }

  .hero-bg-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .shape {
    position: absolute;
    border-radius: 50%;
    border: 2px solid rgba(11, 16, 32, 0.06);
    background: rgba(255, 255, 255, 0.14);
  }
  .shape-1 {
    width: 640px;
    height: 640px;
    right: -160px;
    top: -210px;
  }
  .shape-2 {
    width: 440px;
    height: 440px;
    right: -60px;
    top: -110px;
    background: rgba(255, 255, 255, 0.22);
  }
  .shape-3 {
    width: 260px;
    height: 260px;
    right: 30px;
    top: -20px;
    border-color: rgba(11, 16, 32, 0.1);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 48px;
    align-items: center;
  }
  .hero-copy {
    max-width: 720px;
  }
  .hero .eyebrow {
    color: var(--ink);
    opacity: 0.75;
    font-weight: 800;
    margin-bottom: 16px;
  }
  .hero .eyebrow::before {
    background: var(--ink);
    opacity: 0.7;
  }
  .hero h1 {
    color: var(--ink);
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    font-family: "Manrope", sans-serif;
    font-weight: 800;
    letter-spacing: -.045em;
    line-height: 1.02;
    margin: 0 0 20px;
    word-break: keep-all;
    hyphens: none;
  }
  .hero h1 :global(span) {
    color: var(--ink);
    opacity: 0.85;
    text-decoration: underline;
    text-decoration-color: rgba(11, 16, 32, 0.25);
    text-underline-offset: 6px;
  }
  .hero p {
    font-size: 1.15rem;
    line-height: 1.65;
    color: #1A2135;
    opacity: 0.9;
    max-width: 620px;
    margin: 0 0 32px;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .btn-dark {
    background: var(--ink);
    color: #ffffff;
    padding: 16px 32px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 1rem;
    transition: transform .2s, box-shadow .2s;
    text-decoration: none;
  }
  .btn-dark:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(11, 16, 32, 0.2);
    color: #ffffff;
  }
  .btn-soft {
    background: rgba(11, 16, 32, 0.08);
    color: var(--ink);
    padding: 16px 32px;
    border-radius: 999px;
    font-weight: 800;
    font-size: 1rem;
    border: 1px solid rgba(11, 16, 32, 0.12);
    transition: background .2s, transform .2s;
    text-decoration: none;
  }
  .btn-soft:hover {
    background: rgba(11, 16, 32, 0.14);
    transform: translateY(-2px);
    color: var(--ink);
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .media-frame {
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4/3;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(11, 16, 32, 0.15);
    border: 4px solid rgba(255, 255, 255, 0.5);
    transform: rotate(2deg);
    transition: transform .3s;
  }
  .media-frame:hover {
    transform: rotate(0deg) scale(1.02);
  }
  .media-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-badge {
    position: absolute;
    bottom: -16px;
    left: 20px;
    background: #ffffff;
    color: var(--ink);
    padding: 14px 20px;
    border-radius: 20px;
    box-shadow: 0 12px 30px rgba(11, 16, 32, 0.12);
    border: 1px solid rgba(11, 16, 32, 0.06);
  }
  .hero-badge small {
    display: block;
    font-size: .75rem;
    color: var(--muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
  }
  .hero-badge strong {
    font: 800 1.05rem "Manrope", sans-serif;
  }

  .subcats {
    padding: 0 0 80px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 26px;
  }
  .section-head h2 {
    font-size: clamp(2.8rem, 5vw, 5.4rem);
    font-family: "Manrope", sans-serif;
    font-weight: 800;
    letter-spacing: -.055em;
    line-height: .94;
    margin: 0;
  }
  .section-head p {
    max-width: 520px;
    color: var(--muted);
    line-height: 1.65;
    margin: 0;
  }
  .subgrid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }
  .subcard {
    min-height: 190px;
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: .25s;
    background: #fff;
    text-decoration: none;
    color: var(--ink);
  }
  .subcard:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
  }
  .subcard:nth-child(1) { background: var(--pink); }
  .subcard:nth-child(2) { background: var(--mint); }
  .subcard:nth-child(3) { background: var(--violet); }
  .subcard:nth-child(4) { background: var(--cream); }
  .subcard:nth-child(5) { background: var(--lime); }

  .subicon {
    width: 46px;
    height: 46px;
    background: #ffffff;
    border: 1px solid rgba(11, 16, 32, 0.14);
    border-radius: 14px;
    display: grid;
    place-items: center;
    color: var(--ink);
    box-shadow: 0 4px 12px rgba(11, 16, 32, 0.06);
    flex: none;
  }
  .subcard strong {
    font: 800 1.25rem / 1.1 "Manrope", sans-serif;
    display: block;
    margin-bottom: 4px;
  }
  .subcard span {
    font-size: .85rem;
    color: #555C6C;
  }

  .courses {
    padding: 90px 0;
    background: var(--cream);
  }
  .courses .section-head h2,
  .courses .section-head .eyebrow {
    color: var(--ink);
  }
  .course-toolbar {
    display: flex;
    justify-content: flex-start;
    gap: 18px;
    align-items: center;
    margin-bottom: 26px;
  }

  .courses-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 42px;
  }
  .btn-more-courses {
    padding: 16px 36px;
    font-size: 1rem;
    font-weight: 800;
    border-radius: 999px;
    box-shadow: 0 12px 30px rgba(11, 16, 32, 0.18);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .btn-more-courses:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 36px rgba(11, 16, 32, 0.24);
  }
  .filters {
    display: flex;
    gap: 9px;
    overflow: auto;
  }
  .filter {
    border: 1px solid var(--line);
