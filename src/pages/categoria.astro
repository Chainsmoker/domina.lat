    letter-spacing: -.035em;
    margin: 10px 0;
    color: var(--ink);
  }
  .desc {
    color: #4E5465;
    line-height: 1.58;
    margin: 0 0 16px;
    font-size: .95rem;
  }
  .facts {
    display: flex;
    gap: 8px;
