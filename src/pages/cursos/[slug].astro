---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import CourseCard from '../../components/CourseCard.astro';
import { getCourses, getCourseBySlug } from '../../lib/sanity/queries';
import { urlFor } from '../../lib/sanity/image';
import { formatTitle } from '../../lib/utils/formatTitle';
import { formatPrice } from '../../lib/utils/formatPrice';

export async function getStaticPaths() {
  const courses = await getCourses();
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { slug: course.slug }
  }));
}

const { slug } = Astro.props;
const course = await getCourseBySlug(slug);

if (!course) {
  return Astro.redirect('/404');
}

const allCourses = await getCourses();
const relatedCourses = allCourses
  .filter((c) => c.slug !== course.slug)
  .slice(0, 3);

const formattedTitle = formatTitle(course.title);
const rawTitle = course.title.replace(/<[^>]*>/g, '');
const courseCategory = course.category?.title || 'Belleza';
const coursePrice = formatPrice(course.price) || '$39';
const courseImage = course.heroImage ? urlFor(course.heroImage).width(1400).url() : '/images/hero-manicure.webp';

// Creador / Autor opcional desde Sanity
const creatorName = course.authorName || '';
const creatorRole = course.authorRole || '';
const creatorInitials = creatorName ? creatorName.split(' ').map(n => n[0]).join('').substring(0, 2) : '';
const creatorPhoto = course.authorAvatar ? urlFor(course.authorAvatar).width(900).url() : '';
const hasAuthor = Boolean(creatorName);

// Color dinámico de fondo y texto para la sección del autor desde Sanity
const authorBgColor = course.authorBgColor || '#8D7CFF';
const authorTextColor = course.authorTextColor || '#0B1020';

// Rating opcional de Sanity
const ratingScore = course.ratingScore;
const ratingText = course.ratingText || 'valoración mostrada por la plataforma del curso';

// Temario opcional de Sanity
const modules = course.modules && course.modules.length > 0 ? course.modules : [];

// Qué aprenderás desde Sanity
const learnCards = course.learnItems && course.learnItems.length > 0 ? course.learnItems : [];

// Para quién sí / no desde Sanity
const forYou = course.forYouIf && course.forYouIf.length > 0 ? course.forYouIf : [];
const notForYou = course.notForYouIf && course.notForYouIf.length > 0 ? course.notForYouIf : [];

// Veredicto editorial desde Sanity
const editorialScore = course.editorialScore;
const editorialTitle = course.editorialTitle || '';
const pros = course.editorialPros && course.editorialPros.length > 0 ? course.editorialPros : [];
const cons = course.editorialCons && course.editorialCons.length > 0 ? course.editorialCons : [];
const hasVerdict = Boolean(editorialScore || editorialTitle || pros.length > 0 || cons.length > 0);
const reviewSections = course.reviewSections && course.reviewSections.length > 0 ? course.reviewSections : [];
const reviewImageUrl = (image: any, width = 1200) => image ? urlFor(image).width(width).url() : courseImage;
const pageTitle = course.seoTitle || `${rawTitle} | Domina`;
const pageDescription = course.seoDescription || course.dek || `Análisis completo de ${rawTitle}: temario, creador, recursos, nivel y opiniones.`;
const pageImage = course.ogImage ? urlFor(course.ogImage).width(1200).url() : courseImage;

// Preguntas frecuentes desde Sanity
const faqs = course.faqs && course.faqs.length > 0 ? course.faqs : [];

const courseJsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": rawTitle,
  "description": pageDescription,
  "provider": {
    "@type": "Organization",
    "name": "Domina",
    "sameAs": "https://domina.lat"
  },
  "image": pageImage,
  ...(typeof course.price === 'number' ? {
    "offers": {
      "@type": "Offer",
      "category": courseCategory,
      "priceCurrency": "USD",
      "price": course.price
    }
  } : {})
};

const jsonLd = faqs.length > 0
  ? [
      courseJsonLd,
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map((faq: { question: string; answer: string }) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }))
      }
    ]
  : courseJsonLd;
---

<Layout title={pageTitle} description={pageDescription} image={pageImage} type="course" jsonLd={jsonLd}>
  <main class="page-producto">
    <!-- BREADCRUMBS -->
    <div class="container breadcrumbs">
      <a href="/">Inicio</a> / <a href="/cursos">Cursos</a> / <span>{rawTitle}</span>
    </div>

    <!-- HERO DE DETALLE DE PRODUCTO -->
    <section class="hero">
      <div class="container hero-grid">
        <!-- VISUAL IZQUIERDA -->
        <div class="visual">
          <span class="stamp">{course.resourceType || course.eyebrow || 'Video curso'}</span>
          <img src={courseImage} alt={rawTitle} />
          <div class="visual-copy">
            <strong>De cero a tu primer servicio.</strong>
            <span>Una ruta visual, práctica y pensada para comenzar.</span>
          </div>
        </div>

        <!-- DETALLES DERECHA -->
        <div class="course-main">
          <span class="eyebrow">{courseCategory} · {course.level || 'Nivel inicial'}</span>
          <h1 class="display" set:html={formattedTitle} />
          <p class="lead">{course.dek || 'Una formación para aprender preparación, esmaltado, decoración y atención al cliente con una ruta clara antes de empezar a ofrecer el servicio.'}</p>

          <!-- AUTOR BADGE (SOLO SI TIENE AUTOR EN SANITY) -->
          {hasAuthor && (
            <div class="creator">
              {creatorPhoto ? (
                <img class="avatar" src={creatorPhoto} alt={creatorName} style="object-fit:cover;" />
              ) : (
                <span class="avatar">{creatorInitials}</span>
              )}
              <div>
                <strong>{creatorName}</strong>
                {creatorRole && <small>{creatorRole}</small>}
              </div>
            </div>
          )}

          <!-- RATING (SOLO SI TIENE RATING EN SANITY) -->
          {typeof ratingScore === 'number' && (
            <div class="rating" style="color:var(--ink)">
              <span>★★★★★</span> {ratingScore} <small style="color:var(--muted);font-weight:500">· {ratingText}</small>
            </div>
          )}

          <!-- FACTS -->
          {course.facts && course.facts.length > 0 && (
            <div class="facts">
              {course.facts.map((fact: string) => <span class="fact">{fact}</span>)}
            </div>
          )}

          <!-- CAJA DE COMPRA -->
          <div class="purchase">
            <div class="price-row">
              <div class="price">
                <del>$59</del>
                <strong>{coursePrice}</strong>
              </div>
              <span>Oferta indicada por el vendedor</span>
            </div>
            <a class="btn btn-acid" href={`/go/${course.slug}`} target="_blank" rel="sponsored nofollow">
              Ver oferta oficial ↗
            </a>
            <small>Revisa el precio, moneda, garantía y condiciones finales antes de pagar.</small>
            <div class="purchase-list">
              <span>✓ Pago en plataforma externa</span>
              <span>✓ Acceso digital</span>
              <span>✓ Compatible con móvil</span>
              <span>✓ Recursos incluidos</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN QUÉ APRENDERÁS (SOLO SI TIENE ITEMS EN SANITY) -->
    {learnCards.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <div>
              <span class="eyebrow">Qué aprenderás</span>
              <h2 class="display">Resultados prácticos de esta formación.</h2>
            </div>
            <p>Puntos principales destacados para evaluar el alcance de este curso.</p>
          </div>
          <div class="learn-grid">
            {learnCards.map((card, idx) => (
              <article class="learn-card">
                <i>{String(idx + 1).padStart(2, '0')}</i>
                <h3>{card.title}</h3>
                {card.desc && <p>{card.desc}</p>}
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- SECCIÓN SPLIT (PARA TI SI / NO ES PARA TI SI) -->
    {(forYou.length > 0 || notForYou.length > 0) && (
      <section class="section" style="padding-top:0">
        <div class="container split">
          {forYou.length > 0 && (
            <div class="panel">
              <h2>Este curso puede ser para ti si…</h2>
              <div class="checklist">
                {forYou.map((item) => (
                  <div class="check"><b>✓</b><span>{item}</span></div>
                ))}
              </div>
            </div>
          )}
          {notForYou.length > 0 && (
            <div class="panel">
              <h2>No es la mejor opción si…</h2>
              <div class="checklist">
                {notForYou.map((item) => (
                  <div class="check"><b>×</b><span>{item}</span></div>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- SECCIÓN TEMARIO INTERACTIVO (SOLO SI TIENE MÓDULOS EN SANITY) -->
    {modules.length > 0 && (
      <section class="curriculum">
        <div class="container curriculum-grid">
          <div>
            <span class="eyebrow">Temario</span>
            <h2 class="display">La ruta, módulo por módulo.</h2>
            <p>Estructura de módulos y contenido del programa.</p>
          </div>
          <div class="modules" id="modulesAccordion">
            {modules.map((mod: any, idx: number) => (
              <div class={`module-item ${idx === 0 ? 'active' : ''}`}>
                <button type="button" class="module-trigger" aria-expanded={idx === 0 ? "true" : "false"}>
                  <span>{mod.moduleTitle}</span>
                  <div class="summary-right">
                    {mod.lessons && mod.lessons.length > 0 && (
                      <em>{typeof mod.lessons[0] === 'string' && mod.lessons[0].includes('clases') ? mod.lessons[0] : `${mod.lessons.length} lecciones`}</em>
                    )}
                    <svg class="chevron-icon" width="14" height="9" viewBox="0 0 14 9" fill="none">
                      <path d="M1 1.5l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </button>
                <div class="module-content">
                  <div class="module-inside">
                    {mod.moduleDesc && <p>{mod.moduleDesc}</p>}
                    {mod.lessons && mod.lessons.length > 0 && typeof mod.lessons[0] === 'string' && !mod.lessons[0].includes('clases') && (
                      <ul style="margin:8px 0 0;padding-left:18px">
                        {mod.lessons.map((lesson: string) => <li>✦ {lesson}</li>)}
                      </ul>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- SECCIÓN AUTOR (SOLO SI TIENE AUTOR EN SANITY) -->
    {hasAuthor && (
      <section class="author">
        <div class="container">
          <div class="author-card" style={`background: ${authorBgColor}; color: ${authorTextColor};`}>
            {creatorPhoto && (
              <div class="author-photo">
                <img src={creatorPhoto} alt={creatorName} />
              </div>
            )}
            <div class="author-copy">
              <span class="eyebrow" style={`color: ${authorTextColor === '#FFFFFF' ? '#D7FF5F' : 'inherit'}`}>Sobre el instructor</span>
              <h2 class="display" style={`color: ${authorTextColor}`}>{creatorName}.</h2>
              {course.authorBio && <p style={`color: ${authorTextColor}`}>{course.authorBio}</p>}
            </div>
          </div>
        </div>
      </section>
    )}
    {reviewSections.length > 0 && (
      <section class="review-modules">
        <div class="container">
          <div class="review-modules-heading">
            <span class="eyebrow">Dossier Domina</span>
            <h2 class="display">Evaluación hecha<br /><span>para decidir mejor.</span></h2>
            <p>Una lectura editorial por bloques: lo que contiene, cómo se aplica y qué conviene revisar antes de comprar.</p>
          </div>
          <div class="review-modules-stack">
            {reviewSections.map((section: any, index: number) => {
              const theme = section.theme || 'ink';
              if (section._type === 'reviewFeature') {
                const imageUrl = reviewImageUrl(section.image);
                return (
                  <article class={`review-feature theme-${theme} ${section.imageSide === 'left' ? 'image-left' : ''}`}>
                    <div class="review-feature-copy">
                      {section.eyebrow && <span class="review-label">{section.eyebrow}</span>}
                      <span class="review-index">0{index + 1}</span>
                      <h3>{section.title}</h3>
                      <p>{section.body}</p>
                    </div>
                    <div class="review-feature-media">
                      <div class="review-orbit orbit-a"></div><div class="review-orbit orbit-b"></div>
                      <img src={imageUrl} alt={section.image?.alt || rawTitle} width="1200" height="900" loading="lazy" decoding="async" />
                      <span class="review-media-badge">Domina<br />revisa</span>
                    </div>
                  </article>
                );
              }
              if (section._type === 'reviewMetrics') {
                return (
                  <article class={`review-metrics theme-${theme}`}>
                    <div class="review-metrics-intro">
                      {section.eyebrow && <span class="review-label">{section.eyebrow}</span>}
                      <h3>{section.title}</h3>
                      {section.body && <p>{section.body}</p>}
                    </div>
                    <div class="review-metrics-grid">
                      {section.items?.map((item: any) => {
                        const value = Math.max(0, Math.min(10, Number(item.value) || 0));
                        return <div class="review-metric"><div class="review-meter" style={`--meter:${value * 10}%`}><strong>{value.toFixed(1)}</strong><small>/10</small></div><b>{item.label}</b>{item.note && <span>{item.note}</span>}</div>;
                      })}
                    </div>
                  </article>
                );
              }
              if (section._type === 'reviewChecklist') {
                return (
                  <article class={`review-checklist tone-${section.tone || 'positive'}`}>
                    <div class="review-checklist-intro">
                      {section.eyebrow && <span class="review-label">{section.eyebrow}</span>}
                      <h3>{section.title}</h3>
                      {section.body && <p>{section.body}</p>}
                    </div>
                    <ol>
                      {section.items?.map((item: string, itemIndex: number) => <li><span>{String(itemIndex + 1).padStart(2, '0')}</span>{item}</li>)}
                    </ol>
                  </article>
                );
              }
              if (section._type === 'reviewQuote') {
                return (
                  <blockquote class={`review-quote theme-${theme}`}>
                    <span class="quote-mark">“</span><p>{section.quote}</p><footer>{section.attribution || 'Equipo editorial Domina'}</footer>
                  </blockquote>
                );
              }
              if (section._type === 'reviewGallery') {
                return (
                  <article class="review-gallery">
                    <div class="review-gallery-heading">{section.eyebrow && <span class="review-label">{section.eyebrow}</span>}<h3>{section.title}</h3></div>
                    <div class={`review-gallery-grid ${section.images?.length === 1 ? 'single' : ''}`}>{section.images?.map((image: any) => <figure><img src={reviewImageUrl(image, 1000)} alt={image.alt || rawTitle} width="1000" height="750" loading="lazy" decoding="async" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</div>
                  </article>
                );
              }
              if (section._type === 'reviewCallout') {
                return <aside class={`review-callout theme-${theme}`}><span>{section.label}</span><h3>{section.title}</h3><p>{section.body}</p><i aria-hidden="true">✦</i></aside>;
              }
              return null;
            })}
          </div>
        </div>
      </section>
    )}
    {reviewSections.length === 0 && course.editorialReview && course.editorialReview.length > 0 && (
      <section class="editorial-review-section">
        <div class="container">
          <div class="editorial-frame">
            <header class="editorial-hero">
              <div class="editorial-copy">
                <span class="editorial-kicker"><i></i>Análisis profundo</span>
                <h2 class="display">Evaluación<br />Editorial <em>Domina.</em></h2>
                <p>Una lectura editorial independiente para entender alcance, ritmo y puntos que debes revisar antes de decidir.</p>
                <div class="editorial-signals" aria-label="Criterios editoriales">
                  <span>Contenido</span>
                  <span>Aplicación</span>
                  <span>Claridad</span>
                </div>
              </div>
              <div class="editorial-visual" aria-hidden="true">
                <div class="editorial-ring ring-one"></div>
                <div class="editorial-ring ring-two"></div>
                <div class="editorial-ring ring-three"></div>
                <div class="editorial-image-wrap">
                  <img src={courseImage} alt="" width="800" height="1000" loading="lazy" decoding="async" />
                </div>
                <div class="editorial-stamp"><span>DOM</span><b>Selección<br />editorial</b></div>
              </div>
            </header>
            <article class="content editorial-content">
              <div class="editorial-reading-label"><span>01</span> Lectura del equipo Domina</div>
              <div class="editorial-prose">
                {course.editorialReview.map((block: any) => {
                  if (block._type === 'block') {
                    const text = block.children?.map((child: any) => child.text).join('') || '';
                    const blockId = text.toLowerCase().replace(/[^a-z0-9]+/g, '-');
                    if (block.style === 'h2') return <h2 id={blockId}>{text}</h2>;
                    if (block.style === 'h3') return <h3>{text}</h3>;
                    if (block.style === 'blockquote') return <blockquote>{text}</blockquote>;
                    return <p>{text}</p>;
                  }
                  if (block._type === 'image' && block.asset) {
                    return (
                      <figure class="post-media-block">
                        <img src={urlFor(block).width(900).url()} alt={block.alt || rawTitle} loading="lazy" decoding="async" />
                        {block.caption && <figcaption>{block.caption}</figcaption>}
                      </figure>
                    );
                  }
                  return null;
                })}
              </div>
            </article>
          </div>
        </div>
      </section>
    )}

    <!-- SECCIÓN VEREDICTO EDITORIAL (SOLO SI TIENE EVALUACIÓN EN SANITY) -->
    {hasVerdict && (
      <section class="verdict">
        <div class="container verdict-grid">
          <div class="score">
            <span class="eyebrow">Evaluación editorial</span>
            {typeof editorialScore === 'number' && <div class="score-num">{editorialScore}</div>}
            {editorialTitle && <h2>{editorialTitle}</h2>}
          </div>
          <div class="proscons">
            {pros.length > 0 && (
              <article class="pc">
                <h3>Lo mejor</h3>
                <ul>
                  {pros.map((pro) => <li>{pro}</li>)}
                </ul>
              </article>
            )}
            {cons.length > 0 && (
              <article class="pc">
                <h3>A considerar</h3>
                <ul>
                  {cons.map((con) => <li>{con}</li>)}
                </ul>
              </article>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- SECCIÓN PREGUNTAS FRECUENTES (FAQS) -->
    {faqs.length > 0 && (
      <section class="faq">
        <div class="container faq-grid">
          <div>
            <span class="eyebrow">Preguntas frecuentes</span>
            <h2 class="display">Dudas sobre este curso.</h2>
            <p>Respuestas claras a las preguntas más habituales antes de comenzar tu formación.</p>
          </div>
          <div class="faq-list">
            {faqs.map((faq: { question: string; answer: string }) => (
              <details>
                <summary>
                  <span>{faq.question}</span>
                  <div class="faq-icon">
                    <svg width="14" height="9" viewBox="0 0 14 9" fill="none">
                      <path d="M1 1.5l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </summary>
                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- SECCIÓN RELACIONADOS REUSANDO EL COMPONENTE OFICIAL CourseCard -->
    {relatedCourses.length > 0 && (
      <section class="related">
        <div class="container">
          <div class="section-head">
            <div>
              <span class="eyebrow">También podría interesarte</span>
              <h2 class="display">Otras rutas para empezar.</h2>
            </div>
            <a class="btn" href="/cursos">Ver todo el catálogo ↗</a>
          </div>
          <div class="cards-grid">
            {relatedCourses.map((rel) => (
              <CourseCard
                tag={rel.eyebrow || rel.category?.title || 'Curso'}
                image={rel.heroImage ? urlFor(rel.heroImage).width(900).url() : '/images/hero-pasteleria.webp'}
                imageAlt={rel.title.replace(/<[^>]*>/g, '')}
                meta={`${rel.category?.title || 'Curso'} ${rel.level ? `· ${rel.level}` : ''}`}
                title={rel.title}
                description={rel.dek || ''}
                href={`/cursos/${rel.slug}`}
                priceText={rel.price}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- STICKY CTA EN BARRA INFERIOR -->
    <div class="sticky-cta" id="stickyCta">
      <strong>{rawTitle} · {coursePrice}</strong>
      <a class="btn btn-acid" href={`/go/${course.slug}`} target="_blank" rel="sponsored nofollow">Ver oferta ↗</a>
      <button class="close" aria-label="Cerrar">×</button>
    </div>
  </main>
</Layout>

<script>
  // Accordion interactivo con animación suave y altura exacta para el temario
  const moduleItems = document.querySelectorAll('.module-item');

  moduleItems.forEach((item) => {
    const trigger = item.querySelector('.module-trigger');
    const content = item.querySelector('.module-content') as HTMLElement;

    // Ajustar altura inicial si viene activo por defecto
    if (item.classList.contains('active') && content) {
      content.style.maxHeight = `${content.scrollHeight}px`;
    } else if (content) {
      content.style.maxHeight = '0px';
    }

    trigger?.addEventListener('click', () => {
      const isExpanded = item.classList.contains('active');

      if (isExpanded) {
        item.classList.remove('active');
        trigger.setAttribute('aria-expanded', 'false');
        if (content) content.style.maxHeight = '0px';
      } else {
        item.classList.add('active');
        trigger.setAttribute('aria-expanded', 'true');
        if (content) content.style.maxHeight = `${content.scrollHeight}px`;
      }
    });
  });

  // Sticky CTA
  const sticky = document.getElementById('stickyCta');
  if (sticky) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 720) {
        sticky.classList.add('show');
      } else {
        sticky.classList.remove('show');
      }
    });

  const closeBtn = sticky.querySelector('.close');
  if (closeBtn) {
    closeBtn.addEventListener('click', () => sticky.remove());
  }

  const reviewModules = document.querySelector('.review-modules');
  if (reviewModules) {
    new IntersectionObserver(([entry]) => {
      sticky.classList.toggle('review-hidden', entry.isIntersecting);
    }, { threshold: 0.08 }).observe(reviewModules);
  }
}
</script>

<style>
  .breadcrumbs {
    padding: 22px 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .breadcrumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--ink);
  }
  .breadcrumbs span {
    color: var(--ink);
    font-weight: 700;
  }

  .hero {
    padding: 16px 0 72px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 38px;
    align-items: start;
  }
  .visual {
    position: relative;
    min-height: 620px;
    border-radius: 34px;
    overflow: hidden;
    background: var(--violet);
    box-shadow: var(--shadow);
  }
  .visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .visual:after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 16, 32, 0.64), transparent 55%);
  }
  .visual-copy {
    position: absolute;
    left: 30px;
    right: 30px;
    bottom: 28px;
    z-index: 2;
    color: #fff;
  }
  .visual-copy strong {
    font: 800 2.2rem/1 "Manrope", sans-serif;
    display: block;
    letter-spacing: -0.04em;
  }
  .visual-copy span {
    display: inline-block;
    margin-top: 10px;
    color: #E4E7EE;
  }
  .stamp {
    position: absolute;
    right: 22px;
    top: 22px;
    z-index: 3;
    background: var(--lime);
    color: var(--ink);
    padding: 8px 16px;
    border-radius: 999px;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    width: auto;
    display: inline-block;
    max-width: max-content;
  }
  .course-main {
    padding: 12px 0;
  }
  .course-main h1 {
    font-size: clamp(2.2rem, 4.2vw, 3.8rem);
    max-width: 720px;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin: 12px 0 0;
  }
  .course-main h1 :global(span) {
    color: var(--orange);
  }
  .lead {
    font-size: 1.15rem;
    line-height: 1.72;
    color: #555D6D;
    max-width: min(100%, 580px);
    width: fit-content;
    margin: 20px 0 24px;
  }
  .creator {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0;
  }
  .avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--violet);
    display: grid;
    place-items: center;
    font-weight: 800;
    color: #fff;
  }
  .creator small {
    display: block;
    color: var(--muted);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 24px 0;
  }
  .fact {
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 9px 12px;
    font-size: 0.84rem;
  }
  .rating {
    display: flex;
    gap: 8px;
    align-items: center;
    font-weight: 700;
  }
  .rating span {
    color: #F4A21B;
  }
  .purchase {
    background: var(--ink);
    color: #fff;
    border-radius: 28px;
    padding: 26px;
    margin-top: 26px;
  }
  .price-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }
  .price strong {
    font: 800 2.3rem "Manrope", sans-serif;
  }
  .price del {
    display: block;
    color: #9DA4B5;
  }
  .purchase .btn-acid {
    width: 100%;
    margin-top: 18px;
    background: var(--lime);
    color: var(--ink);
    border-color: var(--lime);
    padding: 14px 20px;
    border-radius: 999px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .purchase small {
    display: block;
    text-align: center;
    color: #AEB5C6;
    margin-top: 12px;
  }
  .purchase-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 18px;
  }
  .purchase-list span {
    background: #171E32;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px;
    border-radius: 14px;
    font-size: 0.88rem;
  }

  /* SECCIONES */
  .section {
    padding: 90px 0;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    align-items: flex-end;
    margin-bottom: 32px;
  }
  .section-head h2 {
    font-size: clamp(2.8rem, 5vw, 5.6rem);
    max-width: 760px;
    letter-spacing: -0.055em;
    line-height: 0.94;
    margin: 0;
  }
  .section-head p {
    max-width: 520px;
    color: var(--muted);
    line-height: 1.65;
    margin: 0;
  }
  /* BENTO GRID DE TAMAÑOS ASIMÉTRICOS PARA TARJETAS */
  .learn-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .learn-card {
    background: white;
    border: 1px solid var(--line);
    border-radius: 26px;
    padding: 26px;
    min-height: 210px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .learn-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(11, 16, 32, 0.06);
  }
  .learn-card:nth-child(1) {
    grid-column: span 2;
    background: var(--cream);
  }
  .learn-card:nth-child(2) {
    grid-column: span 1;
  }
  .learn-card:nth-child(3) {
    grid-column: span 1;
  }
  .learn-card:nth-child(4) {
    grid-column: span 2;
  }
  .learn-card i {
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: var(--lime);
    display: grid;
    place-items: center;
    font-style: normal;
    font-weight: 800;
  }
  .learn-card h3 {
    font: 800 1.25rem/1.15 "Manrope", sans-serif;
    margin: 24px 0 8px;
    letter-spacing: -0.02em;
  }
  .learn-card p {
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
  }

  /* SECCIÓN MORADA: SEÑALES DE LA PROPUESTA */
  .signals-section {
    padding: 40px 0 80px;
  }
  .signals-card {
    background: linear-gradient(135deg, #9685FF 0%, #7E6CF3 100%);
    color: #ffffff;
    border-radius: 36px;
    padding: 56px 64px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
    box-shadow: 0 24px 60px rgba(126, 108, 243, 0.22);
    position: relative;
    overflow: hidden;
  }
  .signals-copy {
    max-width: 600px;
  }
  .signals-eyebrow {
    display: block;
    font: 800 0.8rem "Manrope", sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 18px;
  }
  .signals-title {
    font: 800 clamp(2.4rem, 4.2vw, 3.8rem) / 1.02 "Manrope", sans-serif;
    letter-spacing: -0.045em;
    margin: 0 0 18px 0;
    color: #ffffff;
  }
  .signals-desc {
    font-size: 1.1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
  }
  .signals-meters {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    justify-items: center;
  }
  .meter-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .ring-chart {
    position: relative;
    width: 120px;
    height: 120px;
    margin-bottom: 16px;
  }
  .donut {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .donut-bg {
    fill: #ffffff;
    stroke: rgba(255, 255, 255, 0.25);
    stroke-width: 10;
  }
  .donut-fill {
    fill: transparent;
    stroke: #D7FF5F;
    stroke-width: 10;
    stroke-linecap: round;
    transition: stroke-dashoffset 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .meter-val {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--ink);
  }
  .meter-val strong {
    font: 800 1.65rem / 1 "Manrope", sans-serif;
    letter-spacing: -0.03em;
  }
  .meter-val small {
    font-size: 0.72rem;
    font-weight: 700;
    color: #666;
    margin-top: 2px;
  }
  .meter-label {
    font: 800 1.05rem / 1.2 "Manrope", sans-serif;
    color: #ffffff;
    display: block;
    margin-bottom: 4px;
  }
  .meter-sub {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.78);
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
  }
  .panel {
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 28px;
  }
  .panel h2 {
    font: 800 2.2rem/1 "Manrope", sans-serif;
    letter-spacing: -0.045em;
    margin: 0 0 20px;
  }
  .checklist {
    display: grid;
    gap: 12px;
  }
  .check {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .check:last-child {
    border-bottom: 0;
  }
  .check b {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--mint);
    display: grid;
    place-items: center;
    flex: none;
  }
  .check span {
    line-height: 1.5;
  }

  /* TEMARIO NOCTURNO CON ACCORDION SUAVE */
  .curriculum {
    padding: 90px 0;
    background: var(--ink) !important;
    color: #ffffff !important;
  }
  .curriculum-grid {
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    gap: 38px;
    align-items: start;
  }
  .curriculum h2 {
    font-size: clamp(3rem, 6vw, 6rem);
    letter-spacing: -0.055em;
    line-height: 0.94;
    margin: 0 0 16px;
    color: #ffffff !important;
  }
  .curriculum p {
    color: #B6BDCC !important;
    line-height: 1.7;
    margin: 0;
  }
  .modules {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: stretch;
  }
  .module-item {
    background: #171E32;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 14px;
    overflow: hidden;
    color: #ffffff;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .module-item.active {
    border-color: rgba(215, 255, 95, 0.35);
    background: #1C253E;
  }
  .module-trigger {
    width: 100%;
    border: 0;
    background: transparent;
    padding: 12px 18px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font: 700 0.98rem "Manrope", sans-serif;
    color: #ffffff;
    text-align: left;
  }
  .summary-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .summary-right em {
    font-style: normal;
    color: var(--lime);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .chevron-icon {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    stroke: var(--lime);
    flex: none;
  }
  .module-item.active .chevron-icon {
    transform: rotate(180deg);
  }
  .module-content {
    max-height: 0px;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
    opacity: 0;
  }
  .module-item.active .module-content {
    opacity: 1;
  }
  .module-inside {
    padding: 0 18px 14px;
    color: #BFC5D1;
    line-height: 1.55;
    font-size: 0.92rem;
  }

  /* AUTOR CON COLORES DINÁMICOS DESDE SANITY */
  .author {
    padding: 90px 0;
  }
  .author-card {
    display: grid;
    grid-template-columns: 0.65fr 1.35fr;
    gap: 30px;
    border-radius: 30px;
    padding: 30px;
    align-items: center;
  }
  .author-photo {
    height: 390px;
    border-radius: 24px;
    overflow: hidden;
  }
  .author-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .author-copy h2 {
    font-size: clamp(3rem, 5vw, 5.4rem);
    letter-spacing: -0.055em;
    line-height: 0.94;
    margin: 0 0 16px;
  }
  .author-copy p {
    line-height: 1.7;
    max-width: 650px;
  }
  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .metric {
    padding: 13px 16px;
    border-radius: 16px;
  }
  .metric strong {
    display: block;
    font: 800 1.2rem "Manrope", sans-serif;
  }

  /* DOSSIER EDITORIAL MODULAR */
  .review-modules { padding: 110px 0; background: #fff; overflow: hidden; }
  .review-modules-heading { max-width: 880px; margin: 0 auto 54px; text-align: center; }
  .review-modules-heading h2 { margin: 16px 0; font-size: clamp(3.2rem, 7vw, 7.2rem); }
  .review-modules-heading h2 span { color: var(--orange); }
  .review-modules-heading p { max-width: 570px; margin: 0 auto; color: var(--muted); font-size: 1.08rem; line-height: 1.65; }
  .review-modules-stack { display: grid; gap: 28px; }
  .review-label { display: inline-flex; align-items: center; gap: 9px; color: inherit; font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; }
  .review-label::before { content: ""; width: 26px; height: 2px; background: currentColor; }
  .review-feature { min-height: 510px; display: grid; grid-template-columns: 1fr 1fr; border-radius: 32px; overflow: hidden; color: #fff; }
  .review-feature.image-left .review-feature-copy { order: 2; }
  .review-feature.image-left .review-feature-media { order: 1; }
  .review-feature-copy { position: relative; display: flex; flex-direction: column; justify-content: center; padding: clamp(34px, 6vw, 80px); overflow: hidden; }
  .review-feature-copy::after { content: ""; position: absolute; width: 230px; height: 230px; right: -92px; bottom: -102px; border: 30px solid rgba(255,255,255,.1); border-radius: 50%; pointer-events: none; }
  .review-feature-copy .review-label { color: var(--lime); }
  .review-index { order: -1; margin-bottom: 28px; color: rgba(255,255,255,.28); font: 800 clamp(4rem, 7vw, 7rem)/.7 "Manrope", sans-serif; letter-spacing: -.08em; }
  .review-feature h3 { max-width: 560px; margin: 18px 0; font: 800 clamp(2.45rem, 4vw, 4.7rem)/.95 "Manrope", sans-serif; letter-spacing: -.06em; }
  .review-feature p { max-width: 500px; margin: 0; color: rgba(255,255,255,.78); font-size: 1.05rem; line-height: 1.72; }
  .review-feature-media { position: relative; overflow: hidden; min-height: 340px; background: #dce0e9; }
  .review-feature-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(11,16,32,.12), rgba(11,16,32,.44)); }
  .review-feature-media img { width: 100%; height: 100%; object-fit: cover; }
  .review-orbit { position: absolute; z-index: 2; border: 1px solid rgba(255,255,255,.8); border-radius: 50%; }
  .orbit-a { width: 300px; height: 300px; top: -145px; right: -108px; }
  .orbit-b { width: 185px; height: 185px; bottom: -70px; left: -50px; border-width: 18px; border-color: var(--lime); }
  .review-media-badge { position: absolute; z-index: 3; right: 28px; bottom: 28px; display: grid; width: 92px; height: 92px; place-items: center; border-radius: 50%; color: var(--ink); background: var(--lime); text-align: center; font: 800 .78rem/1 "Manrope", sans-serif; text-transform: uppercase; letter-spacing: .04em; transform: rotate(-10deg); }
  .theme-ink { background: #10182a; }
  .theme-violet { background: #8d7cff; color: var(--ink); }
  .theme-violet .review-feature-copy .review-label, .theme-violet .review-index { color: #fff; }
  .theme-violet .review-feature p { color: rgba(11,16,32,.72); }
  .theme-orange { background: var(--orange); color: var(--ink); }
  .theme-orange .review-feature-copy .review-label, .theme-orange .review-index { color: #fff; }
  .theme-orange .review-feature p { color: rgba(11,16,32,.75); }
  .theme-lime { background: var(--lime); color: var(--ink); }
  .theme-lime .review-feature-copy .review-label { color: var(--orange); }
  .theme-lime .review-index { color: rgba(11,16,32,.18); }
  .theme-lime .review-feature p { color: rgba(11,16,32,.74); }
  .theme-cream { background: var(--cream); color: var(--ink); }
  .theme-cream .review-feature-copy .review-label { color: var(--orange); }
  .theme-cream .review-index { color: rgba(11,16,32,.16); }
  .theme-cream .review-feature p { color: rgba(11,16,32,.72); }
  .review-metrics { display: grid; grid-template-columns: .72fr 1.28fr; gap: 50px; align-items: center; padding: clamp(36px, 6vw, 78px); border-radius: 32px; }
  .review-metrics.theme-violet { background: linear-gradient(135deg, #8d7cff, #b0a5ff); }
  .review-metrics.theme-cream { background: #eeece5; color: var(--ink); }
  .review-metrics.theme-ink { color: #fff; }
  .review-metrics.theme-ink p, .review-metrics.theme-ink .review-metric span { color: #bfc7d8; }
  .review-metrics h3 { margin: 17px 0; font: 800 clamp(2.2rem, 4vw, 4.2rem)/.98 "Manrope", sans-serif; letter-spacing: -.055em; }
  .review-metrics p { max-width: 420px; margin: 0; color: rgba(11,16,32,.72); line-height: 1.65; }
  .review-metrics-grid { display: grid; grid-template-columns: 1.14fr 1fr .88fr; gap: 12px; align-items: center; }
  .review-metric { min-width: 0; padding: 23px 12px 20px; border: 1px solid rgba(11,16,32,.09); border-radius: 26px; background: rgba(255,255,255,.7); text-align: center; box-shadow: 0 14px 30px rgba(11,16,32,.055); }
  .review-metric:nth-child(1) { transform: translateY(-17px); }
  .review-metric:nth-child(3) { transform: translateY(17px); }
  .review-meter { --meter: 50%; position: relative; display: grid; width: 135px; height: 135px; margin: auto; place-content: center; border-radius: 50%; background: conic-gradient(var(--lime) var(--meter), rgba(255,255,255,.24) 0); }
  .review-meter::after { content: ""; position: absolute; inset: 10px; border-radius: inherit; background: var(--ink); }
  .theme-lime .review-meter::after, .theme-orange .review-meter::after, .theme-violet .review-meter::after, .theme-cream .review-meter::after { background: rgba(255,255,255,.94); }
  .review-meter strong, .review-meter small { position: relative; z-index: 1; }
  .review-meter strong { font: 800 2.4rem/.9 "Manrope", sans-serif; letter-spacing: -.08em; }
  .review-meter small { margin-top: 3px; font-weight: 800; font-size: .65rem; opacity: .65; }
  .review-metric b { display: block; margin-top: 14px; font: 800 .91rem "Manrope", sans-serif; }
  .review-metric span { display: block; margin-top: 4px; color: rgba(11,16,32,.64); font-size: .76rem; line-height: 1.25; }
  .review-checklist { display: grid; grid-template-columns: .82fr 1.18fr; gap: 42px; padding: clamp(35px, 6vw, 74px); border: 1px solid var(--line); border-radius: 32px; background: #fff; }
  .review-checklist.tone-caution { background: #fff1ea; border-color: rgba(255,92,53,.35); }
  .review-checklist h3 { margin: 17px 0; font: 800 clamp(2.15rem, 3.8vw, 3.9rem)/.98 "Manrope", sans-serif; letter-spacing: -.055em; }
  .review-checklist p { margin: 0; color: var(--muted); line-height: 1.65; }
  .review-checklist ol { display: grid; gap: 11px; margin: 0; padding: 0; list-style: none; }
  .review-checklist li { display: grid; grid-template-columns: 38px 1fr; gap: 14px; align-items: center; min-height: 61px; padding: 13px 0; border-bottom: 1px solid rgba(11,16,32,.12); font-weight: 600; line-height: 1.4; }
  .review-checklist li:last-child { border-bottom: 0; }
  .review-checklist li span { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: var(--lime); font: 800 .7rem "Manrope", sans-serif; }
  .tone-caution li span { background: var(--orange); color: #fff; }
  .review-quote { position: relative; margin: 0; padding: clamp(44px, 7vw, 96px); overflow: hidden; border-radius: 32px; color: #fff; }
  .review-quote::after { content: ""; position: absolute; right: -60px; bottom: -165px; width: 460px; height: 460px; border: 45px solid rgba(255,255,255,.11); border-radius: 50%; }
  .review-quote .quote-mark { position: absolute; left: clamp(27px, 4vw, 60px); top: 11px; color: var(--lime); font: 800 10rem/.9 Georgia, serif; }
  .review-quote p { position: relative; z-index: 1; max-width: 910px; margin: 0; font: 800 clamp(2rem, 4vw, 4.4rem)/1.02 "Manrope", sans-serif; letter-spacing: -.06em; }
  .review-quote footer { position: relative; z-index: 1; margin-top: 28px; color: rgba(255,255,255,.72); font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .13em; }
  .review-quote.theme-orange { color: var(--ink); }
  .review-quote.theme-orange .quote-mark { color: #fff; }
  .review-quote.theme-orange footer { color: rgba(11,16,32,.68); }
  .review-gallery { width: min(100%, 920px); margin-inline: auto; padding: clamp(34px, 5vw, 58px); border-radius: 32px; background: #f1efe9; }
  .review-gallery-heading { display: flex; align-items: end; justify-content: space-between; gap: 22px; margin-bottom: 28px; }
  .review-gallery h3 { max-width: 680px; margin: 13px 0 0; font: 800 clamp(2.2rem, 4vw, 4rem)/.98 "Manrope", sans-serif; letter-spacing: -.055em; }
  .review-gallery-grid { display: grid; grid-template-columns: 1.2fr .8fr; grid-auto-rows: 230px; gap: 14px; }
  .review-gallery-grid figure { position: relative; min-height: 0; margin: 0; overflow: hidden; border-radius: 20px; background: #d7d9de; }
  .review-gallery-grid figure:first-child { grid-row: span 2; }
  .review-gallery-grid.single { display: block; }
