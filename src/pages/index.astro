---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import CategoriesSection from '../components/CategoriesSection.astro';
import CoursesSection from '../components/CoursesSection.astro';
import EmprenderSection from '../components/EmprenderSection.astro';
import GuidesSection from '../components/GuidesSection.astro';
import CtaSection from '../components/CtaSection.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://domina.lat/#organization',
      name: 'Domina.lat',
      alternateName: 'Domina',
      url: 'https://domina.lat/',
      logo: 'https://domina.lat/apple-touch-icon.png',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://domina.lat/#website',
      name: 'Domina.lat',
      publisher: { '@id': 'https://domina.lat/#organization' },
      url: 'https://domina.lat/',
      inLanguage: 'es',
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://domina.lat/cursos?q={search_term_string}',
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
---

<Layout title="Domina — Cursos prácticos online para aprender y emprender" description="Cursos online seleccionados de belleza, pastelería, oficios e IA, con análisis de temario, precio y para quién sirve cada uno." image="/images/hero-manicure.webp" jsonLd={jsonLd}>
  <main id="top">
    <Hero />
    <Ticker />
    <CategoriesSection />
    <CoursesSection />
    <EmprenderSection />
    <GuidesSection />
    <CtaSection />
  </main>
</Layout>
