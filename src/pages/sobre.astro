---
import Layout from '../layouts/Layout.astro';

const principles = [
  {
    num: '01',
    title: 'Aplicación práctica',
    desc: 'Priorizamos formaciones con objetivos claros, habilidades concretas y contenidos que puedan ponerse en práctica.'
  },
  {
    num: '02',
    title: 'Información comprensible',
    desc: 'Explicamos nivel, formato, creador, contenido, precio y posibles limitaciones sin esconder lo importante.'
  },
  {
    num: '03',
    title: 'Transparencia',
    desc: 'Indicamos cuándo una recomendación utiliza un enlace de afiliado y evitamos prometer resultados garantizados.'
  }
];

const steps = [
  { num: '1', title: 'Revisamos la propuesta', desc: 'Analizamos para quién es el curso, qué promete enseñar y si esa promesa es razonable.' },
  { num: '2', title: 'Observamos la estructura', desc: 'Consideramos temario, nivel, formato, recursos incluidos y claridad de la experiencia.' },
  { num: '3', title: 'Comparamos contexto y valor', desc: 'Evaluamos si el precio, alcance y enfoque tienen sentido frente a otras alternativas.' },
  { num: '4', title: 'Explicamos pros y límites', desc: 'Una recomendación útil también debe decir para quién podría no ser adecuada.' }
];

const checklist = [
  'No garantizamos ingresos, empleo ni resultados.',
  'No presentamos todos los cursos como ideales para todos.',
  'No ocultamos cuando existe una relación comercial.',
  'No sustituimos el criterio personal ni la investigación propia.'
];
---

<Layout title="Sobre Domina | Cómo seleccionamos cursos" description="Conoce la misión de Domina, cómo seleccionamos cursos y cómo mantenemos la transparencia en nuestras recomendaciones.">
  <main class="page-sobre">
    <header class="hero">
      <div class="container hero-grid">
        <div>
          <span class="eyebrow">Sobre Domina</span>
          <h1 class="display">Elegir bien también <span>es aprender.</span></h1>
          <p>Domina nació para ayudar a personas reales a encontrar cursos y recursos prácticos sin perderse entre promesas exageradas, catálogos interminables o información poco clara.</p>
          <div class="hero-actions">
            <a class="btn btn-dark" href="/cursos">Explorar cursos ↗</a>
            <a class="btn" href="#criterios">Cómo seleccionamos</a>
          </div>
        </div>
        <div class="visual">
          <div class="visual-main">
            <img src="/images/sobre-aprendizaje.webp" alt="Personas aprendiendo habilidades prácticas" />
          </div>
          <div class="tag">Curaduría antes que cantidad ✦</div>
          <div class="visual-card">
            <strong>No reunimos cursos por reunir.</strong>
            <p>Organizamos opciones para que puedas comparar, entender y decidir con más criterio.</p>
          </div>
        </div>
      </div>
    </header>

    <section class="manifesto" id="manifiesto">
      <div class="ring-decoration" aria-hidden="true">
        <svg width="520" height="520" viewBox="0 0 520 520" fill="none">
          <circle cx="400" cy="120" r="340" stroke="rgba(215, 255, 95, 0.09)" stroke-width="64"/>
          <circle cx="400" cy="120" r="230" stroke="rgba(215, 255, 95, 0.07)" stroke-width="44"/>
          <circle cx="400" cy="120" r="140" stroke="rgba(215, 255, 95, 0.05)" stroke-width="28"/>
        </svg>
      </div>
      <div class="container manifesto-grid">
        <div class="manifesto-intro">
          <div class="manifesto-pill">
            <span class="dot"></span> NUESTRA IDEA
          </div>
          <h2>Menos ruido. <span>Más claridad.</span></h2>
          <p class="lead">
            Creemos que una habilidad práctica abre nuevas posibilidades, pero también que <strong>ningún curso debería venderse como una promesa automática de éxito.</strong>
          </p>
          <p class="sub">
            Por eso Domina combina curaduría editorial, información sin filtro y transparencia comercial para ayudarte a evaluar cada opción antes de invertir tu dinero y tiempo.
          </p>
        </div>
        <div class="manifesto-highlights">
          <div class="highlight-card">
            <span class="icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--lime)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </span>
            <div>
              <strong>Selección editorial</strong>
              <p>Filtramos catálogos interminables para destacar solo formaciones estructuradas y con aplicación real.</p>
            </div>
          </div>
          <div class="highlight-card">
            <span class="icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--lime)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
            </span>
            <div>
              <strong>Información directa</strong>
              <p>Desglosamos temario, nivel, duración, pros y limitaciones sin jerga publicitaria ni letra chica.</p>
            </div>
          </div>
          <div class="highlight-card">
            <span class="icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--lime)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            <div>
              <strong>Transparencia comercial</strong>
              <p>Señalamos abiertamente cuándo un enlace es de afiliado y jamás garantizamos ingresos infundados.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="principles" id="criterios">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Nuestros principios</span>
            <h2>Lo que guía cada recomendación.</h2>
          </div>
          <p>No buscamos tener el catálogo más grande. Buscamos construir uno que sea más fácil de entender y más útil para tomar decisiones.</p>
        </div>
        <div class="principle-grid">
          {principles.map((pr) => (
            <article class="principle">
              <span class="num">{pr.num}</span>
              <div>
                <h3>{pr.title}</h3>
                <p>{pr.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="process">
      <div class="container process-grid">
        <div>
          <span class="eyebrow">Cómo trabajamos</span>
          <h2 class="display" style="font-size:clamp(3.5rem,6vw,6.5rem)">Así evaluamos una formación.</h2>
          <p style="color:var(--muted);line-height:1.7">El proceso puede variar según la categoría, pero estos son los elementos básicos que buscamos antes de recomendar.</p>
        </div>
        <div class="steps">
          {steps.map((st) => (
            <article class="step">
              <b>{st.num}</b>
              <div>
                <h3>{st.title}</h3>
                <p>{st.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="transparency">
      <div class="container trans-grid">
        <article class="trans-card dark">
          <span class="eyebrow">Cómo se sostiene Domina</span>
          <h3>Algunas recomendaciones generan una comisión.</h3>
          <p>Cuando compras mediante ciertos enlaces, Domina puede recibir una comisión del proveedor sin aumentar el precio para ti. Esa relación no debería impedirnos explicar limitaciones o comparar alternativas.</p>
          <a class="btn btn-acid" style="background:var(--lime);margin-top:20px" href="/aviso-afiliados">Leer aviso de afiliados ↗</a>
        </article>
        <article class="trans-card orange">
          <span class="eyebrow">Lo que no hacemos</span>
          <h3>No vendemos humo.</h3>
          <div class="checklist">
            {checklist.map((item) => (
              <div class="check">
                <i>✓</i>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>

    <section class="cta">
      <div class="container">
        <div class="cta-box">
          <div>
            <span class="eyebrow">Empieza por tu objetivo</span>
            <h2>Encuentra una habilidad que tenga sentido para ti.</h2>
          </div>
          <a class="btn btn-dark" href="/cursos">Explorar cursos ↗</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    padding: 64px 0 80px;
    overflow: hidden;
  }
  .hero .container,
  .hero :global(.container) {
    width: min(98%, 1380px) !important;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 40px;
    align-items: center;
  }
  .hero h1 {
    font: 800 clamp(3.2rem, 5.4vw, 5.8rem) / 0.98 "Manrope", sans-serif !important;
    letter-spacing: -0.05em !important;
    margin: 12px 0 0;
  }
  .hero h1 :global(span),
  .hero h1 span {
    display: inline-block;
    color: var(--orange);
  }
  .hero p {
    font-size: 1.15rem;
    line-height: 1.7;
    color: #50586a;
    max-width: 680px;
    margin: 24px 0 32px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .page-sobre .visual,
  .hero .visual {
    min-height: 560px;
    position: relative;
    background: transparent !important;
    border-radius: 0 !important;
    overflow: visible !important;
    box-shadow: none !important;
  }
  .page-sobre .visual::after,
  .hero .visual::after {
    display: none !important;
  }
  .visual-main {
    position: absolute;
    inset: 30px 0 60px 40px;
    border-radius: 34px;
    overflow: hidden;
    box-shadow: var(--shadow);
    z-index: 1;
  }
  .visual-main::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 16, 32, 0.55), transparent 55%);
    z-index: 2;
  }
  .visual-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .visual-card {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 58%;
    background: var(--lime) !important;
    border-radius: 24px;
    padding: 24px;
    transform: rotate(-4deg);
    box-shadow: var(--shadow);
    color: var(--ink) !important;
    z-index: 5;
  }
  .visual-card strong {
    display: block;
    font: 800 1.8rem / 1.05 "Manrope", sans-serif;
    letter-spacing: -0.04em;
    color: var(--ink) !important;
  }
  .visual-card p {
    margin: 8px 0 0;
    color: #43501a !important;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .tag {
    position: absolute;
    right: -5px;
    top: 5px;
    background: #ffffff !important;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 12px 16px;
    font-weight: 800;
    transform: rotate(4deg);
    color: var(--ink) !important;
    box-shadow: 0 8px 20px rgba(11, 16, 32, 0.08);
    z-index: 5;
  }
  .manifesto {
    background: var(--ink);
    color: #fff;
    padding: 100px 0;
    position: relative;
    overflow: hidden;
  }
  .ring-decoration {
    position: absolute;
    top: -100px;
    right: -100px;
    pointer-events: none;
    z-index: 1;
  }
  .manifesto :global(.container),
  .manifesto .container {
    width: min(98%, 1380px) !important;
    position: relative;
    z-index: 2;
  }
  .manifesto-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 60px;
    align-items: center;
  }
  .manifesto-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 6px 14px;
    border-radius: 999px;
    font: 800 0.76rem "Manrope", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #e2e7f0;
    margin-bottom: 20px;
  }
  .manifesto-pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 3px rgba(215, 255, 95, 0.25);
  }
  .manifesto h2 {
    font: 800 clamp(2.8rem, 5vw, 5.2rem) / 0.98 "Manrope", sans-serif !important;
    letter-spacing: -0.045em !important;
    color: #ffffff !important;
    margin: 0 0 24px;
  }
  .manifesto h2 :global(span),
  .manifesto h2 span {
    color: var(--lime) !important;
    display: block;
  }
  .manifesto p.lead {
    font-size: 1.22rem;
    line-height: 1.7;
    color: #e2e7f0;
    margin: 0 0 16px;
    max-width: 620px;
  }
  .manifesto p.lead strong {
    color: #ffffff;
    font-weight: 800;
  }
  .manifesto p.sub {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #aeb5c6;
    margin: 0;
    max-width: 600px;
  }
  .manifesto-highlights {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .highlight-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 24px 26px;
    display: flex;
    gap: 18px;
    align-items: flex-start;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
  }
  .highlight-card:hover {
    transform: translateX(6px);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(215, 255, 95, 0.4);
  }
  .highlight-card .icon {
    font-size: 1.4rem;
    background: rgba(255, 255, 255, 0.08);
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .highlight-card strong {
    display: block;
    font: 800 1.15rem / 1.2 "Manrope", sans-serif;
    color: #ffffff;
    margin-bottom: 6px;
  }
  .highlight-card p {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.55;
    color: #c6cbd4;
  }
  .principles {
    padding: 110px 0;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    align-items: flex-end;
    margin-bottom: 44px;
  }
  .section-head h2 {
    font: 800 clamp(3.4rem, 6vw, 6.4rem) / 0.95 "Manrope", sans-serif;
    letter-spacing: -0.055em;
    margin: 0;
  }
  .section-head p {
    max-width: 520px;
    color: var(--muted);
    line-height: 1.7;
  }
  .principle-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .principle {
    border: 1px solid var(--line);
    border-radius: 26px;
    padding: 26px;
    background: #fff;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .principle:nth-child(2) {
    background: var(--cream);
  }
  .principle:nth-child(3) {
    background: var(--violet);
    color: #fff;
  }
  .principle:nth-child(3) p {
    color: #e0d8ff;
  }
  .num {
    font: 800 3.8rem "Manrope", sans-serif;
    letter-spacing: -0.07em;
  }
  .principle h3 {
    font: 800 1.55rem / 1.05 "Manrope", sans-serif;
    letter-spacing: -0.04em;
    margin: 0 0 12px;
  }
  .principle p {
    color: #555d6e;
    line-height: 1.65;
    margin: 0;
  }
  .process {
    padding: 105px 0;
    background: var(--cream);
  }
  .process-grid {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: 50px;
  }
  .steps {
    display: grid;
    gap: 12px;
  }
  .page-sobre .steps .step {
    display: grid !important;
    grid-template-columns: 58px 1fr !important;
    gap: 18px !important;
    background: #fff !important;
    border: 1px solid var(--line) !important;
    border-radius: 22px !important;
    padding: 22px !important;
    min-height: auto !important;
    flex-direction: row !important;
    box-shadow: none !important;
    transform: none !important;
  }
  .page-sobre .steps .step b {
    width: 58px !important;
    height: 58px !important;
    border-radius: 18px !important;
    background: var(--ink) !important;
    color: #fff !important;
    display: grid !important;
    place-items: center !important;
    font: 800 1.25rem "Manrope", sans-serif !important;
  }
  .page-sobre .steps .step h3 {
    font: 800 1.25rem "Manrope", sans-serif !important;
    color: var(--ink) !important;
    margin: 2px 0 7px !important;
  }
  .page-sobre .steps .step p {
    margin: 0 !important;
    color: var(--muted) !important;
    line-height: 1.55 !important;
    font-size: 0.95rem !important;
  }
  .transparency {
    padding: 110px 0;
  }
  .trans-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .trans-card {
    border-radius: 30px;
    padding: 34px;
    min-height: 420px;
  }
  .trans-card.dark {
    background: var(--ink);
    color: #fff;
  }
  .trans-card.orange {
    background: var(--orange);
    color: var(--ink);
  }
  .trans-card h3 {
    font: 800 clamp(2.7rem, 5vw, 5rem) / 0.95 "Manrope", sans-serif;
    letter-spacing: -0.055em;
    margin: 0 0 24px;
  }
  .trans-card p {
    font-size: 1.08rem;
    line-height: 1.75;
  }
  .trans-card.dark p {
    color: #c6cbd6;
  }
  .checklist {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }
  .check {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .check i {
    width: 27px;
    height: 27px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
    display: grid;
    place-items: center;
    font-style: normal;
    font-weight: 900;
    flex: none;
  }
  .cta {
    padding: 0 0 110px;
  }
  .cta-box {
    background: var(--lime);
    border-radius: 34px;
    padding: 60px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    color: var(--ink);
  }
  .cta-box h2 {
    font: 800 clamp(3.4rem, 6vw, 6.8rem) / 0.93 "Manrope", sans-serif;
    letter-spacing: -0.06em;
    margin: 0;
    max-width: 820px;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .manifesto-grid,
    .process-grid,
    .trans-grid {
      grid-template-columns: 1fr;
    }
    .visual {
      min-height: 470px;
    }
    .principle-grid {
      grid-template-columns: 1fr;
    }
    .cta-box {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 680px) {
    .hero {
      padding-top: 45px;
    }
    .display {
      font-size: clamp(3.8rem, 18vw, 5.5rem);
    }
    .visual {
      min-height: 390px;
    }
    .visual-main {
      inset: 20px 0 55px 15px;
    }
    .visual-card {
      width: 78%;
      padding: 18px;
    }
    .manifesto,
    .principles,
    .process,
    .transparency {
      padding: 78px 0;
    }
    .section-head {
      display: block;
    }
    .cta-box {
      padding: 30px;
    }
  }
</style>
