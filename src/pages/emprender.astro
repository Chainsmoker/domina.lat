---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { getCourses, getPosts } from '../lib/sanity/queries';
import { urlFor } from '../lib/sanity/image';
import { formatPrice } from '../lib/utils/formatPrice';

const allFetchedCourses = await getCourses();
const allFetchedPosts = await getPosts();

// Página prerenderizada: la fecha de actualización es la del build (cuando cambian los datos).
const updatedAt = new Date();
const updatedLabel = updatedAt.toLocaleDateString('es', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Mexico_City' });

const stripHtml = (t: string) => t.replace(/<[^>]*>/g, '');

// Comparativa: todos los cursos del catálogo, con datos de Sanity (nada inventado).
const roundup = allFetchedCourses.map((c) => ({
  slug: c.slug,
  title: stripHtml(c.title),
  category: c.category?.title || 'Curso',
  format: c.resourceType || c.eyebrow || 'Curso online',
  price: formatPrice(c.price) || 'Ver precio',
  dek: c.dek || '',
  forYou: (c.forYouIf || []).slice(0, 3),
  notForYou: (c.notForYouIf || []).slice(0, 2),
  creator: c.authorName || '',
  score: typeof c.editorialScore === 'number' ? c.editorialScore : null,
  image: c.ogImage ? urlFor(c.ogImage).width(640).url() : (c.heroImage ? urlFor(c.heroImage).width(640).url() : '/images/hero-manicure.webp'),
}));

const criteria = [
  { num: '01', title: 'Propuesta realista', desc: 'Revisamos para quién es el curso, qué promete enseñar y si esa promesa es razonable. Descartamos los que garantizan ingresos.' },
  { num: '02', title: 'Estructura y temario', desc: 'Miramos módulos, nivel de entrada, formato y recursos incluidos: ¿se puede practicar lo que enseña sin comprar más cosas?' },
  { num: '03', title: 'Precio frente a alcance', desc: 'Comparamos el precio indicado por el vendedor con lo que cubre y con otras opciones del catálogo.' },
  { num: '04', title: 'Para quién no es', desc: 'Cada análisis dice también quién debería evitarlo. Si no encontramos límites claros, no lo recomendamos.' },
];

const roundupJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Cursos para emprender desde casa',
  url: 'https://domina.lat/emprender',
  dateModified: updatedAt.toISOString(),
  isPartOf: { '@id': 'https://domina.lat/#website' },
  publisher: { '@id': 'https://domina.lat/#organization' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: roundup.length,
    itemListElement: roundup.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://domina.lat/cursos/${c.slug}`,
      name: c.title,
    })),
  },
};

// Guías de la categoría emprendimiento (no las 3 más recientes de cualquier tema).
const emprenderPosts = allFetchedPosts.filter((p) => p.category?.slug === 'emprendimiento');
const dynamicGuides = (emprenderPosts.length >= 3 ? emprenderPosts : allFetchedPosts).slice(0, 3).map((p) => ({
  image: p.heroImage ? urlFor(p.heroImage).width(850).url() : '/images/hero-manicure.webp',
  imageAlt: p.title.replace(/<[^>]*>/g, ''),
  category: p.category?.title || p.eyebrow || 'Guía',
  title: p.title,
  desc: p.dek || 'Guía práctica para entender la oportunidad.',
  link: `/guias/${p.slug}`
}));

const stats = [
  { title: 'Servicios', desc: 'Uñas, belleza, reparación y habilidades que puedes ofrecer.' },
  { title: 'Productos', desc: 'Pastelería, panadería, costura y creaciones vendibles.' },
  { title: 'Digital', desc: 'Diseño, contenido, IA y marketing para trabajar online.' },
  { title: 'Con criterio', desc: 'Comparamos inversión, dificultad y tipo de oportunidad.' }
];

const paths = [
  {
    image: '/images/ruta-servicios.webp',
    imageAlt: 'Servicio de uñas profesionales',
    pill: 'Servicios',
    pillColor: 'var(--lime)',
    title: 'Trabaja con clientes',
    desc: 'Uñas, pestañas, maquillaje, barbería o reparación. Ideal si disfrutas resolver necesidades directamente.',
    link: '/categoria/belleza-y-unas'
  },
  {
    image: '/images/ruta-productos.webp',
    imageAlt: 'Pastelería para vender',
    pill: 'Productos',
    pillColor: 'var(--orange)',
    title: 'Crea y vende',
    desc: 'Pastelería, panadería, costura o manualidades. Convierte técnica y presentación en productos concretos.',
    link: '/categoria/cocina-y-pasteleria'
  },
  {
    image: '/images/ruta-digital.webp',
    imageAlt: 'Trabajo digital desde computadora',
    pill: 'Digital',
    pillColor: 'var(--violet)',
    title: 'Ofrece habilidades online',
    desc: 'Diseño, contenido, marketing e inteligencia artificial para prestar servicios sin depender de un local.',
    link: '/categoria/digital-e-ia'
  }
];

const tableData = [
  { idea: 'Uñas profesionales', inversion: 'Baja–media', invBadgeClass: '', aprendizaje: 'Práctica constante', venta: 'Servicio local' },
  { idea: 'Pastelería', inversion: 'Media', invBadgeClass: 'orange', aprendizaje: 'Técnica + producción', venta: 'Pedidos y catálogo' },
  { idea: 'Reparación de celulares', inversion: 'Media', invBadgeClass: 'violet', aprendizaje: 'Diagnóstico técnico', venta: 'Servicio especializado' },
  { idea: 'Diseño y contenido', inversion: 'Baja', invBadgeClass: '', aprendizaje: 'Portafolio + práctica', venta: 'Servicio remoto' }
];

const steps = [
  { num: '01', title: 'Elige una habilidad', desc: 'Según tus intereses, presupuesto, tiempo y forma preferida de trabajar.' },
  { num: '02', title: 'Aprende y practica', desc: 'Avanza con proyectos pequeños antes de cobrar o asumir pedidos complejos.' },
  { num: '03', title: 'Prueba la demanda', desc: 'Habla con clientes potenciales, muestra ejemplos y valida qué necesitan.' },
  { num: '04', title: 'Mejora tu oferta', desc: 'Ajusta calidad, costos, presentación y experiencia con cada trabajo.' }
];
---

<Layout title="Cursos para emprender desde casa: comparativa | Domina.lat" description="Comparamos los cursos para emprender desde casa del catálogo: precio, formato, para quién sirve y para quién no, y cómo los elegimos." jsonLd={roundupJsonLd}>
  <main class="page-emprender">
    <section class="hero">
      <div class="container">
        <div class="hero-card">
          <div class="hero-copy">
            <div>
              <div class="hero-eyebrow-pill">
                <span class="dot"></span> DOMINA PARA EMPRENDER
              </div>
              <h1 class="display">Cursos para emprender desde casa. <span>Comparados.</span></h1>
              <p class="updated">Actualizado el <time datetime={updatedAt.toISOString()}>{updatedLabel}</time> · {roundup.length} cursos analizados</p>
              <p>Explora rutas prácticas que se convierten en servicios, productos o pequeños negocios. Evaluamos temarios, inversión inicial y alternativas reales antes de sugerirte un curso.</p>
              <div class="hero-actions">
                <a class="btn btn-acid" href="#ideas">Explorar ideas ↗</a>
                <a class="btn btn-light" href="/cursos">Ver catálogo de cursos</a>
              </div>
            </div>
            <div class="trust-features">
              <div class="trust-item">
                <span class="trust-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--lime)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                </span>
                <div>
                  <b>Inversión clara</b>
                  <small>Sin costos ocultos</small>
                </div>
              </div>
              <div class="trust-item">
                <span class="trust-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--lime)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                </span>
                <div>
                  <b>Paso a paso</b>
                  <small>Desde cero</small>
                </div>
              </div>
              <div class="trust-item">
                <span class="trust-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--lime)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </span>
                <div>
                  <b>Evaluación real</b>
                  <small>Cursos probados</small>
                </div>
              </div>
            </div>
          </div>
          <div class="hero-media">
            <img src="/images/emprender-gestion.webp" alt="Persona gestionando un emprendimiento" />
            <div class="float-badge top-right">
              <span class="badge-dot-live"></span> Ruta destacada 2026
            </div>
            <div class="float-card-new bottom-left">
              <div class="icon-circle" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg>
              </div>
              <div>
                <strong>Servicios & Negocios</strong>
                <span>Baja inversión · Alta demanda</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="stats">
      <div class="container stats-grid">
        {stats.map((s) => (
          <div class="stat">
            <b>{s.title}</b>
            <span>{s.desc}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section" id="ideas">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Rutas para comenzar</span>
            <h2 class="display">Rutas prácticas para <span>comenzar.</span></h2>
          </div>
          <p>No todas las personas quieren el mismo tipo de negocio. Elige según cómo prefieres trabajar, vender y relacionarte con clientes.</p>
        </div>
        <div class="paths">
          {paths.map((p) => (
            <article class="path">
              <img src={p.image} alt={p.imageAlt} />
              <div class="path-copy">
                <span class="pill" style={`background:${p.pillColor}`}>{p.pill}</span>
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
                <a class="btn" style="border-color:#fff;color:#fff" href={p.link}>Ver cursos ↗</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section compare" id="comparativa">
      <div class="container compare-grid">
        <div>
          <span class="eyebrow">Comparación rápida</span>
          <h2 class="display">Elige según tu <span>realidad.</span></h2>
          <p>Estas referencias son orientativas. La inversión y el tiempo dependen del país, herramientas, experiencia y alcance del servicio.</p>
          <a class="btn btn-dark" href="/guias">Leer guías para decidir ↗</a>
        </div>
        <div class="table">
          <div class="row head">
            <div>Idea</div>
            <div>Inversión inicial</div>
            <div>Curva de aprendizaje</div>
            <div>Forma de vender</div>
          </div>
          {tableData.map((row) => (
            <div class="row">
              <div class="idea">{row.idea}</div>
              <div data-label="Inversión">
                <span class={`badge ${row.invBadgeClass}`}>{row.inversion}</span>
              </div>
              <div data-label="Aprendizaje">{row.aprendizaje}</div>
              <div data-label="Venta">{row.venta}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="method" id="como-elegimos">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Cómo elegimos</span>
            <h2 class="display">Cuatro filtros antes de <span>recomendar.</span></h2>
          </div>
          <p>Domina.lat no vende cursos: los recomienda con enlaces de afiliado. Por eso explicamos qué miramos y qué no prometemos. Más detalle en <a href="/sobre">cómo trabajamos</a> y en el <a href="/aviso-afiliados">aviso de afiliados</a>.</p>
        </div>
        <ol class="method-grid">
          {criteria.map((c) => (
            <li class="method-item">
              <span class="method-num">{c.num}</span>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="courses" id="cursos">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Comparativa</span>
            <h2 class="display">Los {roundup.length} cursos, <span>lado a lado.</span></h2>
          </div>
          <p>Precio indicado por el vendedor al {updatedLabel}; puede cambiar. Cada nombre lleva al análisis completo del curso.</p>
        </div>
        {roundup.length > 0 ? (
          <>
            <div class="roundup-table-wrap">
              <table class="roundup-table">
                <caption class="sr-only">Comparativa de cursos para emprender desde casa</caption>
                <thead>
                  <tr>
                    <th scope="col">Curso</th>
                    <th scope="col">Área</th>
                    <th scope="col">Formato</th>
                    <th scope="col">Precio</th>
                    <th scope="col">Ideal si…</th>
                  </tr>
                </thead>
                <tbody>
                  {roundup.map((c) => (
                    <tr>
                      <th scope="row"><a href={`/cursos/${c.slug}`}>{c.title}</a></th>
                      <td data-label="Área">{c.category}</td>
                      <td data-label="Formato">{c.format}</td>
                      <td data-label="Precio">{c.price}</td>
                      <td data-label="Ideal si">{c.forYou[0] || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="roundup-list">
              {roundup.map((c, i) => (
                <article class="roundup-item" id={`curso-${c.slug}`}>
                  <img src={c.image} alt={c.title} width="640" height="360" loading="lazy" decoding="async" />
                  <div class="roundup-copy">
                    <span class="roundup-meta">{String(i + 1).padStart(2, '0')} · {c.category} · {c.format}</span>
                    <h3><a href={`/cursos/${c.slug}`}>{c.title}</a></h3>
                    {c.creator && <p class="roundup-creator">Creado por {c.creator}</p>}
                    {c.dek && <p>{c.dek}</p>}
                    {(c.forYou.length > 0 || c.notForYou.length > 0) && (
                      <div class="roundup-fit">
                        {c.forYou.length > 0 && (
                          <div>
                            <b>Sirve si</b>
                            <ul>{c.forYou.map((t: string) => <li>{t}</li>)}</ul>
                          </div>
                        )}
                        {c.notForYou.length > 0 && (
                          <div>
                            <b>No es para ti si</b>
                            <ul>{c.notForYou.map((t: string) => <li>{t}</li>)}</ul>
                          </div>
                        )}
                      </div>
                    )}
                    <div class="roundup-foot">
                      <strong>{c.price}</strong>
                      <a class="btn btn-dark" href={`/cursos/${c.slug}`}>Leer análisis ↗</a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </>
        ) : (
          <div class="empty-state-card">
            <div class="empty-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
            </div>
            <h3>Próximamente cursos en esta sección</h3>
            <p>Estamos seleccionando los mejores cursos para emprender por categoría. Publicaremos las recomendaciones muy pronto.</p>
            <a href="/cursos" class="btn btn-acid">Ver catálogo completo ↗</a>
          </div>
        )}
      </div>
    </section>

    <section class="steps" id="pasos">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Ruta realista</span>
            <h2 class="display">Aprender no es el <span>último paso.</span></h2>
          </div>
          <p>Un curso puede ayudarte a comenzar, pero el resultado depende de práctica, validación, servicio y consistencia.</p>
        </div>
        <div class="step-grid">
          {steps.map((st) => (
            <div class="step">
              <div class="num">{st.num}</div>
              <h3>{st.title}</h3>
              <p>{st.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="guides">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Antes de invertir</span>
            <h2 class="display">Guías para decidir mejor.</h2>
          </div>
          <p>Contenido práctico para comprender la oportunidad antes de comprar herramientas o una formación.</p>
        </div>
        {dynamicGuides.length > 0 ? (
          <div class="guide-grid">
            {dynamicGuides.map((g) => (
              <article class="guide">
                <div class="guide-media">
                  <img src={g.image} alt={g.imageAlt} />
                </div>
                <div class="guide-body">
                  <small>{g.category}</small>
                  <h3>{g.title}</h3>
                  <p>{g.desc}</p>
                  <a href={g.link}>Leer guía ↗</a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state-card">
            <div class="empty-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
            </div>
            <h3>Próximamente guías en esta sección</h3>
            <p>Pronto publicaremos guías paso a paso para ayudarte a decidir el mejor camino antes de invertir.</p>
            <a href="/guias" class="btn btn-acid">Explorar todas las guías ↗</a>
          </div>
        )}
      </div>
    </section>

    <section class="cta">
      <div class="container">
        <div class="cta-box">
          <div>
            <span class="eyebrow">Empieza con una decisión</span>
            <h2 class="display">¿Qué habilidad encaja contigo?</h2>
            <p>Explora cursos, compara opciones y construye una ruta que tenga sentido para tu tiempo, presupuesto y objetivos.</p>
          </div>
          <div class="cta-actions">
            <a class="btn btn-dark" href="/cursos">Explorar cursos ↗</a>
            <a class="btn" href="/guias">Leer guías</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    padding: 42px 0 24px;
  }
  .hero .container,
  .hero :global(.container) {
    width: min(1280px, calc(100% - 36px)) !important;
  }
  .hero-card {
    background: var(--ink);
    color: #fff;
    border-radius: 32px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    min-height: 520px;
    box-shadow: 0 30px 80px rgba(11, 16, 32, 0.18);
  }
  .hero-copy {
    padding: 48px 52px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }
  .hero-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 6px 14px;
    border-radius: 999px;
    font: 800 0.76rem "Manrope", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #e2e7f0;
    margin-bottom: 16px;
  }
  .hero-eyebrow-pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 3px rgba(215, 255, 95, 0.25);
  }
  .hero h1 {
    font-size: clamp(2.6rem, 4.4vw, 4.4rem) !important;
    letter-spacing: -0.04em !important;
    line-height: 1.04 !important;
    color: #ffffff !important;
    margin-bottom: 14px;
  }
  .hero h1 :global(span),
  .hero h1 span {
    color: var(--lime) !important;
    display: block;
  }
  .hero p {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #c0c6d4;
    max-width: 540px;
    margin: 0;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .hero .btn-acid {
    background: var(--lime);
    color: var(--ink);
    border-color: var(--lime);
    padding: 13px 22px;
  }
  .hero .btn-light {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 13px 22px;
    backdrop-filter: blur(10px);
  }
  .hero .btn-light:hover {
    background: #fff;
    color: var(--ink);
  }
  .trust-features {
    display: flex;
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    flex-wrap: wrap;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .trust-icon {
    font-size: 1.2rem;
  }
  .trust-item b {
    display: block;
    font-size: 0.86rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
  }
  .trust-item small {
    display: block;
    font-size: 0.78rem;
    color: #aeb5c6;
  }

  .hero-media {
    position: relative;
    height: 100%;
    min-height: 480px;
  }
  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(11, 16, 32, 0.5), transparent 40%),
      linear-gradient(0deg, rgba(11, 16, 32, 0.35), transparent 35%);
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .float-badge {
    position: absolute;
    z-index: 2;
    background: rgba(11, 16, 32, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    padding: 8px 16px;
