---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { getCourses, getPosts } from '../lib/sanity/queries';
import { urlFor } from '../lib/sanity/image';
import { formatPrice } from '../lib/utils/formatPrice';

const allFetchedCourses = await getCourses();
const allFetchedPosts = await getPosts();

// Página prerenderizada: la fecha de actualización es la del build (cuando cambian los datos).
const updatedAt = new Date();
const updatedLabel = updatedAt.toLocaleDateString('es', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Mexico_City' });

const stripHtml = (t: string) => t.replace(/<[^>]*>/g, '');

// Comparativa: todos los cursos del catálogo, con datos de Sanity (nada inventado).
const roundup = allFetchedCourses.map((c) => ({
  slug: c.slug,
  title: stripHtml(c.title),
  category: c.category?.title || 'Curso',
  format: c.resourceType || c.eyebrow || 'Curso online',
  price: formatPrice(c.price) || 'Ver precio',
  dek: c.dek || '',
  forYou: (c.forYouIf || []).slice(0, 3),
  notForYou: (c.notForYouIf || []).slice(0, 2),
  creator: c.authorName || '',
  score: typeof c.editorialScore === 'number' ? c.editorialScore : null,
  image: c.ogImage ? urlFor(c.ogImage).width(640).url() : (c.heroImage ? urlFor(c.heroImage).width(640).url() : '/images/hero-manicure.webp'),
}));

// Áreas para los filtros (orden de primera aparición, con conteo).
const areas = Object.values(
  roundup.reduce((acc: Record<string, { name: string; count: number }>, c) => {
    (acc[c.category] ||= { name: c.category, count: 0 }).count++;
    return acc;
  }, {}),
);

const priceValues = allFetchedCourses
  .map((c) => (typeof c.price === 'number' ? c.price : parseFloat(String(c.price ?? '').replace(/[^0-9.]/g, ''))))
  .filter((n) => Number.isFinite(n) && n > 0);
const minPrice = priceValues.length ? formatPrice(Math.min(...priceValues)) : '';

const criteria = [
  { num: '01', title: 'Propuesta realista', desc: 'Revisamos para quién es el curso, qué promete enseñar y si esa promesa es razonable. Descartamos los que garantizan ingresos.' },
  { num: '02', title: 'Estructura y temario', desc: 'Miramos módulos, nivel de entrada, formato y recursos incluidos: ¿se puede practicar lo que enseña sin comprar más cosas?' },
  { num: '03', title: 'Precio frente a alcance', desc: 'Comparamos el precio indicado por el vendedor con lo que cubre y con otras opciones del catálogo.' },
  { num: '04', title: 'Para quién no es', desc: 'Cada análisis dice también quién debería evitarlo. Si no encontramos límites claros, no lo recomendamos.' },
];

const pageTitle = `Cursos para emprender desde casa: ${roundup.length} comparados (${updatedAt.getFullYear()})`;
const pageDescription = `Comparamos ${roundup.length} cursos de emprendimiento online${minPrice ? ` desde ${minPrice}` : ''}: precio, formato, para quién sirve y para quién no. Actualizado el ${updatedLabel}.`;

const roundupJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Cursos para emprender desde casa',
  url: 'https://domina.lat/emprender',
  dateModified: updatedAt.toISOString(),
  isPartOf: { '@id': 'https://domina.lat/#website' },
  publisher: { '@id': 'https://domina.lat/#organization' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: roundup.length,
    itemListElement: roundup.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://domina.lat/cursos/${c.slug}`,
      name: c.title,
    })),
  },
};

// Guías de la categoría emprendimiento (no las 3 más recientes de cualquier tema).
const emprenderPosts = allFetchedPosts.filter((p) => p.category?.slug === 'emprendimiento');
const dynamicGuides = (emprenderPosts.length >= 3 ? emprenderPosts : allFetchedPosts).slice(0, 3).map((p) => ({
  image: p.heroImage ? urlFor(p.heroImage).width(850).url() : '/images/hero-manicure.webp',
  imageAlt: p.title.replace(/<[^>]*>/g, ''),
  category: p.category?.title || p.eyebrow || 'Guía',
  title: stripHtml(p.title),
  desc: p.dek || 'Guía práctica para entender la oportunidad.',
  link: `/guias/${p.slug}`
}));

const paths = [
  {
    image: '/images/ruta-servicios.webp',
    imageAlt: 'Servicio de uñas profesionales',
    pill: 'Servicios',
    pillColor: 'var(--lime)',
    title: 'Trabaja con clientes',
    desc: 'Uñas, pestañas, maquillaje, barbería o reparación. Ideal si disfrutas resolver necesidades directamente.',
    link: '/categoria/belleza-y-unas'
  },
  {
    image: '/images/ruta-productos.webp',
    imageAlt: 'Pastelería para vender',
    pill: 'Productos',
    pillColor: 'var(--orange)',
    title: 'Crea y vende',
    desc: 'Pastelería, panadería, costura o manualidades. Convierte técnica y presentación en productos concretos.',
    link: '/categoria/cocina-y-pasteleria'
  },
  {
    image: '/images/ruta-digital.webp',
    imageAlt: 'Trabajo digital desde computadora',
    pill: 'Digital',
    pillColor: 'var(--violet)',
    title: 'Ofrece habilidades online',
    desc: 'Diseño, contenido, marketing e inteligencia artificial para prestar servicios sin depender de un local.',
    link: '/categoria/digital-e-ia'
  }
];

const tableData = [
  { idea: 'Uñas profesionales', inversion: 'Baja–media', invBadgeClass: '', aprendizaje: 'Práctica constante', venta: 'Servicio local' },
  { idea: 'Pastelería', inversion: 'Media', invBadgeClass: 'orange', aprendizaje: 'Técnica + producción', venta: 'Pedidos y catálogo' },
  { idea: 'Reparación de celulares', inversion: 'Media', invBadgeClass: 'violet', aprendizaje: 'Diagnóstico técnico', venta: 'Servicio especializado' },
  { idea: 'Diseño y contenido', inversion: 'Baja', invBadgeClass: '', aprendizaje: 'Portafolio + práctica', venta: 'Servicio remoto' }
];

const steps = [
  { num: '01', title: 'Elige una habilidad', desc: 'Según tus intereses, presupuesto, tiempo y forma preferida de trabajar.' },
  { num: '02', title: 'Aprende y practica', desc: 'Avanza con proyectos pequeños antes de cobrar o asumir pedidos complejos.' },
  { num: '03', title: 'Prueba la demanda', desc: 'Habla con clientes potenciales, muestra ejemplos y valida qué necesitan.' },
  { num: '04', title: 'Mejora tu oferta', desc: 'Ajusta calidad, costos, presentación y experiencia con cada trabajo.' }
];
---

<Layout title={pageTitle} description={pageDescription} jsonLd={roundupJsonLd}>
  <main class="page-emprender">
    <section class="hero">
      <div class="container">
        <div class="em-hero-card">
          <div class="em-hero-copy">
            <div class="hero-eyebrow-pill">
              <span class="dot"></span> Domina para emprender
            </div>
            <h1 class="display">Cursos para emprender desde casa. <span>Comparados.</span></h1>
            <p>Rutas prácticas que se convierten en servicios, productos o pequeños negocios. Revisamos temarios, inversión inicial y alternativas reales antes de recomendarte un curso.</p>
            <div class="em-hero-actions">
              <a class="btn btn-acid" href="#cursos">Ver los {roundup.length} cursos ↓</a>
              <a class="btn btn-light" href="#ideas">Elegir por ruta</a>
            </div>
            <dl class="hero-stats">
              <div>
                <dt>cursos comparados</dt>
                <dd>{roundup.length}</dd>
              </div>
              <div>
                <dt>áreas de negocio</dt>
                <dd>{areas.length}</dd>
              </div>
              {minPrice && (
                <div>
                  <dt>precio de entrada</dt>
                  <dd>{minPrice}</dd>
                </div>
              )}
            </dl>
          </div>
          <div class="hero-media">
            <img src="/images/emprender-gestion.webp" alt="Persona gestionando un emprendimiento" fetchpriority="high" />
            <div class="float-badge top-right">
              <span class="badge-dot-live"></span> Actualizado el <time datetime={updatedAt.toISOString()}>{updatedLabel}</time>
            </div>
            <div class="float-card-new bottom-left">
              <div class="icon-circle" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              </div>
              <div>
                <strong>Precio, formato y encaje</strong>
                <span>Para quién sí y para quién no</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="ideas">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Rutas para comenzar</span>
            <h2 class="display">¿Cómo quieres <span>ganarte la vida?</span></h2>
          </div>
          <p>No todas las personas quieren el mismo tipo de negocio. Elige según cómo prefieres trabajar, vender y relacionarte con clientes.</p>
        </div>
        <div class="paths">
          {paths.map((p) => (
            <a class="path" href={p.link}>
              <img src={p.image} alt={p.imageAlt} loading="lazy" decoding="async" />
              <div class="path-copy">
                <span class="pill" style={`background:${p.pillColor}`}>{p.pill}</span>
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
                <span class="path-go">Ver cursos <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="em-courses" id="cursos">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Comparativa</span>
            <h2 class="display">Los {roundup.length} cursos, <span>lado a lado.</span></h2>
          </div>
          <p>Filtra por área y compara precio, formato y para quién sirve cada uno. Precios del vendedor al {updatedLabel}; pueden cambiar.</p>
        </div>
        {roundup.length > 0 ? (
          <>
            <div class="rc-filters" role="group" aria-label="Filtrar cursos por área" hidden>
              <button type="button" class="rc-chip is-active" data-filter="all" aria-pressed="true">Todos <span>{roundup.length}</span></button>
              {areas.map((a) => (
                <button type="button" class="rc-chip" data-filter={a.name} aria-pressed="false">{a.name} <span>{a.count}</span></button>
              ))}
            </div>
            <p class="rc-status" role="status" aria-live="polite" hidden></p>

            <div class="rc-grid">
              {roundup.map((c) => (
                <article class="rc" id={`curso-${c.slug}`} data-area={c.category}>
                  <a class="rc-media" href={`/cursos/${c.slug}`} tabindex="-1" aria-hidden="true">
                    <img src={c.image} alt="" width="640" height="400" loading="lazy" decoding="async" />
                    <span class="rc-tag">{c.category}</span>
                  </a>
                  <div class="rc-body">
                    <span class="rc-meta">{c.format}{c.creator ? ` · ${c.creator}` : ''}</span>
                    <h3><a href={`/cursos/${c.slug}`}>{c.title}</a></h3>
                    {c.dek && <p class="rc-dek">{c.dek}</p>}
                    {c.forYou[0] && (
                      <p class="rc-yes"><b>Ideal si</b>{c.forYou[0]}</p>
                    )}
                    {c.notForYou[0] && (
                      <details class="rc-no">
                        <summary>Para quién no es</summary>
                        <p>{c.notForYou[0]}</p>
                      </details>
                    )}
                    <div class="rc-foot">
                      <strong>{c.price}</strong>
                      <span class="rc-link">Leer análisis <span aria-hidden="true">↗</span></span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </>
        ) : (
          <div class="empty-state-card">
            <div class="empty-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
            </div>
            <h3>Próximamente cursos en esta sección</h3>
            <p>Estamos seleccionando los mejores cursos para emprender por categoría. Publicaremos las recomendaciones muy pronto.</p>
            <a href="/cursos" class="btn btn-acid">Ver catálogo completo ↗</a>
          </div>
        )}
      </div>
    </section>

    <section class="section compare" id="comparativa">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Comparación rápida</span>
            <h2 class="display">Elige según tu <span>realidad.</span></h2>
          </div>
          <p>Estas referencias son orientativas. La inversión y el tiempo dependen del país, herramientas, experiencia y alcance del servicio.</p>
        </div>
        <div class="table" role="table" aria-label="Comparación de ideas de negocio">
          <div class="row head" role="row">
            <div role="columnheader">Idea</div>
            <div role="columnheader">Inversión inicial</div>
            <div role="columnheader">Curva de aprendizaje</div>
            <div role="columnheader">Forma de vender</div>
          </div>
          {tableData.map((row) => (
            <div class="row" role="row">
              <div class="idea" role="cell">{row.idea}</div>
              <div role="cell" data-label="Inversión">
                <span class={`badge ${row.invBadgeClass}`}>{row.inversion}</span>
              </div>
              <div role="cell" data-label="Aprendizaje">{row.aprendizaje}</div>
              <div role="cell" data-label="Venta">{row.venta}</div>
            </div>
          ))}
        </div>
        <div class="compare-foot">
          <a class="btn btn-dark" href="/guias">Leer guías para decidir ↗</a>
        </div>
      </div>
    </section>

    <section class="em-steps" id="pasos">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Ruta realista</span>
            <h2 class="display">Aprender no es el <span>último paso.</span></h2>
          </div>
          <p>Un curso puede ayudarte a comenzar, pero el resultado depende de práctica, validación, servicio y consistencia.</p>
        </div>
        <ol class="timeline">
          {steps.map((st) => (
            <li class="tl-item">
              <span class="tl-num">{st.num}</span>
              <h3>{st.title}</h3>
              <p>{st.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="method" id="como-elegimos">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Cómo elegimos</span>
            <h2 class="display">Cuatro filtros antes de <span>recomendar.</span></h2>
          </div>
          <p>Domina.lat no vende cursos: los recomienda con enlaces de afiliado. Por eso explicamos qué miramos y qué no prometemos. Más detalle en <a href="/sobre">cómo trabajamos</a> y en el <a href="/aviso-afiliados">aviso de afiliados</a>.</p>
        </div>
        <ol class="method-grid">
          {criteria.map((c) => (
            <li class="method-item">
              <span class="method-num">{c.num}</span>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section guides">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Antes de invertir</span>
            <h2 class="display">Guías para <span>decidir mejor.</span></h2>
          </div>
          <p>Contenido práctico para comprender la oportunidad antes de comprar herramientas o una formación.</p>
        </div>
        {dynamicGuides.length > 0 ? (
          <div class="guide-grid">
            {dynamicGuides.map((g) => (
              <article class="guide">
                <a class="guide-media" href={g.link} tabindex="-1" aria-hidden="true">
                  <img src={g.image} alt="" loading="lazy" decoding="async" />
                </a>
                <div class="guide-body">
                  <small>{g.category}</small>
                  <h3><a href={g.link}>{g.title}</a></h3>
                  <p>{g.desc}</p>
                  <span class="guide-go">Leer guía <span aria-hidden="true">↗</span></span>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state-card">
            <div class="empty-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
            </div>
            <h3>Próximamente guías en esta sección</h3>
            <p>Pronto publicaremos guías paso a paso para ayudarte a decidir el mejor camino antes de invertir.</p>
            <a href="/guias" class="btn btn-acid">Explorar todas las guías ↗</a>
          </div>
        )}
      </div>
    </section>

    <section class="cta">
      <div class="container">
        <div class="em-cta-box">
          <div>
            <span class="eyebrow">Empieza con una decisión</span>
            <h2 class="display">¿Qué habilidad encaja contigo?</h2>
            <p>Explora cursos, compara opciones y construye una ruta que tenga sentido para tu tiempo, presupuesto y objetivos.</p>
          </div>
          <div class="cta-actions">
            <a class="btn btn-dark" href="/cursos">Explorar cursos ↗</a>
            <a class="btn btn-ghost" href="/guias">Leer guías</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('.rc-grid');
  const bar = document.querySelector<HTMLElement>('.rc-filters');
  const status = document.querySelector<HTMLElement>('.rc-status');
  if (root && bar && status) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.rc'));
    const chips = Array.from(bar.querySelectorAll<HTMLButtonElement>('.rc-chip'));
    bar.hidden = false;
    const apply = (filter: string) => {
      let shown = 0;
      for (const card of cards) {
        const match = filter === 'all' || card.dataset.area === filter;
        card.hidden = !match;
        if (match) shown++;
      }
      for (const chip of chips) {
        const on = chip.dataset.filter === filter;
        chip.classList.toggle('is-active', on);
        chip.setAttribute('aria-pressed', String(on));
      }
      status.hidden = filter === 'all';
      status.textContent = filter === 'all' ? '' : `${shown} de ${cards.length} cursos en ${filter}`;
    };
    bar.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.rc-chip');
      if (chip?.dataset.filter) apply(chip.dataset.filter);
    });
  }
</script>

<style>
  /* ---------- base ---------- */
  .section { padding: 88px 0; }
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: end;
    gap: 24px 56px;
    margin-bottom: 40px;
  }
  .section-head h2 {
    margin-top: 14px;
    text-wrap: balance;
    font-size: clamp(2.2rem, 4.4vw, 3.7rem);
    letter-spacing: -0.045em;
    line-height: 1.02;
  }
  .section-head h2 span { color: var(--orange); }
  .section-head p {
    margin: 0;
    max-width: 460px;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.65;
  }
  .btn-ghost {
    background: transparent;
    color: var(--ink);
  }

  /* ---------- hero ---------- */
  .hero { padding: 36px 0 24px; }
  .em-hero-card {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    min-height: 560px;
    border-radius: 36px;
    background:
      radial-gradient(900px 420px at 0% 0%, rgba(215, 255, 95, 0.1), transparent 60%),
      var(--ink);
    color: #fff;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(11, 16, 32, 0.18);
  }
  .em-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 56px 56px 48px;
  }
  .hero-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 14px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    color: #e2e7f0;
    font: 800 0.74rem "Manrope", sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero-eyebrow-pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 3px rgba(215, 255, 95, 0.25);
  }
  .hero h1 {
    margin: 22px 0 18px;
    max-width: 15ch;
    text-wrap: balance;
    font-size: clamp(2.7rem, 4.8vw, 4.3rem);
    letter-spacing: -0.045em;
    line-height: 1;
    color: #fff;
  }
  .hero h1 span { display: block; color: var(--lime); }
  .em-hero-copy > p {
    margin: 0;
    max-width: 500px;
    color: #c0c6d4;
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .em-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero .btn-acid { background: var(--lime); border-color: var(--lime); color: var(--ink); }
  .hero .btn-light {
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .hero .btn-light:hover { background: #fff; color: var(--ink); }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
    width: 100%;
    margin: 40px 0 0;
    padding-top: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .hero-stats > div { display: flex; flex-direction: column; }
  .hero-stats dd {
    margin: 0;
    font: 800 2.1rem/1 "Manrope", sans-serif;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .hero-stats dt {
    order: 2;
    margin-top: 6px;
    color: #aeb5c6;
    font-size: 0.82rem;
  }
  .hero-media { position: relative; min-height: 440px; }
  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(11, 16, 32, 0.55), transparent 40%),
      linear-gradient(0deg, rgba(11, 16, 32, 0.35), transparent 35%);
  }
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
