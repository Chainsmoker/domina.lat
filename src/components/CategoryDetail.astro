<script>
  const initCategoryInteractions = () => {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    const cards = [...document.querySelectorAll<HTMLElement>('#courseGrid .card')];
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((button) => button.classList.remove('active'));
        btn.classList.add('active');

        const selectedFilter = btn.getAttribute('data-filter') || 'todos';
        let visibleCount = 0;

        cards.forEach((card) => {
          const types = (card.getAttribute('data-types') || '').split(' ');

          if (selectedFilter === 'todos' || types.includes(selectedFilter)) {
            card.style.display = '';
            visibleCount += 1;
          } else {
            card.style.display = 'none';
          }
        });

        const visibleCountEl = document.getElementById('visibleCount');
        if (visibleCountEl) {
          visibleCountEl.textContent = visibleCount.toString();
        }
      });
    });
  };

  initCategoryInteractions();
  document.addEventListener('astro:page-load', initCategoryInteractions);
</script>
