---
const principles = [
  {
    title: "Problema primero",
    description: "El artículo empieza por la duda real del lector, no por vender el curso.",
    badgeBg: "rgba(255, 92, 53, 0.12)",
    badgeColor: "var(--orange)",
    iconSvg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>`
  },
  {
    title: "Afiliación visible",
    description: "Indicamos claramente si una recomendación puede generar una comisión.",
    badgeBg: "rgba(189, 232, 219, 0.45)",
    badgeColor: "#145946",
    iconSvg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>`
  },
  {
    title: "Sin promesas falsas",
    description: "No garantizamos ingresos mágicos, empleo inmediato ni éxito sin esfuerzo.",
    badgeBg: "rgba(215, 255, 95, 0.45)",
    badgeColor: "#415400",
    iconSvg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`
  },
  {
    title: "Comparación útil",
    description: "Explicamos para quién encaja realmente cada opción y sus límites reales.",
    badgeBg: "rgba(141, 124, 255, 0.18)",
    badgeColor: "#4532B8",
    iconSvg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h18"/></svg>`
  }
];
---
<section class="editorial" id="editorial">
  <div class="container editorial-grid">
    <div class="editorial-head">
      <span class="eyebrow">Criterio editorial</span>
      <h2 class="display">No recomendamos <span>a ciegas.</span></h2>
      <p>Las guías de Domina responden a la intención real del estudiante: evaluamos temarios, nivel de exigencia y alternativas antes de sugerir una opción de compra.</p>
      <div class="trust-chip">
        <span class="dot"></span> Evaluaciones independientes y transparentes
      </div>
    </div>
    <div class="principles">
      {principles.map((p) => (
        <article class="principle">
          <div class="icon-wrap" style={`background: ${p.badgeBg}; color: ${p.badgeColor}`}>
            <Fragment set:html={p.iconSvg} />
          </div>
          <div class="principle-content">
            <b>{p.title}</b>
            <span>{p.description}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .editorial {
    padding: 96px 0;
    background: var(--cream);
    position: relative;
  }
  .editorial-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 54px;
    align-items: center;
  }
  .editorial h2 {
    font-size: clamp(3.2rem, 5.8vw, 6rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin: 16px 0 20px;
  }
  .editorial h2 span {
    color: var(--orange);
  }
  .editorial p {
    color: #4b5363;
    font-size: 1.08rem;
    line-height: 1.68;
    max-width: 500px;
    margin: 0 0 28px;
  }
  .trust-chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: #fff;
    border: 1px solid var(--line);
    padding: 10px 16px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--ink);
    box-shadow: 0 4px 14px rgba(11, 16, 32, 0.04);
  }
  .trust-chip .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 3px rgba(215, 255, 95, 0.3);
  }
  .principles {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .principle {
    background: #fff;
    border: 1px solid rgba(11, 16, 32, 0.08);
    border-radius: 20px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 6px 20px rgba(11, 16, 32, 0.03);
  }
  .principle:hover {
    transform: translateX(6px);
    box-shadow: 0 14px 36px rgba(11, 16, 32, 0.07);
    border-color: rgba(255, 92, 53, 0.3);
  }
  .icon-wrap {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .icon-wrap svg {
    width: 22px;
    height: 22px;
    stroke-width: 2.2;
  }
  .principle-content {
    flex: 1;
    min-width: 0;
  }
  .principle b {
    display: block;
    font: 800 1.15rem / 1.2 "Manrope", sans-serif;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .principle span {
    display: block;
    color: #555d6e;
    font-size: 0.94rem;
    line-height: 1.5;
  }

  @media (max-width: 1040px) {
    .editorial-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 720px) {
    .editorial {
      padding: 64px 0;
    }
    .principle {
      padding: 16px 18px;
      gap: 14px;
    }
    .principle:hover {
      transform: translateY(-3px);
    }
  }
</style>
