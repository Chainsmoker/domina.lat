---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'course';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  robots?: string;
}

const {
  title: rawTitle = "Domina.lat — Aprende habilidades reales",
  description: rawDescription = "Cursos seleccionados para aprender habilidades prácticas, emprender y avanzar.",
  image = "/images/hero-manicure.webp",
  canonical,
  type = "website",
  jsonLd,
  robots,
} = Astro.props;

// Títulos: máx. ~60 caracteres. Si el sufijo de marca no cabe, se quita.
const TITLE_MAX = 60;
const BRAND_SUFFIX = /\s*[|—–-]\s*Domina(\.lat)?\s*$/i;
function normalizeTitle(t: string): string {
  const clean = t.replace(/\s+/g, ' ').trim();
  if (clean.length <= TITLE_MAX) return clean;
  return clean.replace(BRAND_SUFFIX, '');
}

// Descripciones: máx. 155 caracteres, cortadas en límite de palabra.
const DESC_MAX = 155;
function normalizeDescription(d: string): string {
  const clean = d.replace(/\s+/g, ' ').trim();
  if (clean.length <= DESC_MAX) return clean;
  const cut = clean.slice(0, DESC_MAX - 1);
  const lastSpace = cut.lastIndexOf(' ');
  return cut.slice(0, lastSpace > 100 ? lastSpace : cut.length).replace(/[\s,;:.\-–—]+$/, '') + '…';
}

const title = normalizeTitle(rawTitle);
const description = normalizeDescription(rawDescription);

const siteUrl = Astro.site || new URL("https://domina.lat");
// Con build.format 'file' las páginas prerenderizadas llegan como /sobre.html o /index.html;
// la canonical debe ser la URL limpia (igual que el sitemap y el redirect 307 de Cloudflare).
const cleanPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
const canonicalUrl = new URL(canonical || cleanPath, siteUrl).href;
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph / Facebook / WhatsApp -->
  <meta property="og:type" content={type === 'course' ? 'website' : type} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:site_name" content="Domina.lat" />
  <meta property="og:locale" content="es_ES" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />

  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet"></noscript>

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  <!-- Google tag (gtag.js): la cola se crea ya; la librería se carga tras el load y en idle
       para no bloquear el hilo principal durante la carga (INP/TBT). -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-Q8RTZTXZL2');
    (function () {
      if (window.__gtagLoaded) return;
      window.__gtagLoaded = true;
      function inject() {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-Q8RTZTXZL2';
        document.head.appendChild(s);
      }
      function schedule() {
        if ('requestIdleCallback' in window) requestIdleCallback(inject, { timeout: 4000 });
        else setTimeout(inject, 1500);
      }
      if (document.readyState === 'complete') schedule();
      else window.addEventListener('load', schedule, { once: true });
    })();
  </script>
  <slot name="head" />
  <ClientRouter />
</head>
<body>
  <div class="global-progress-bar" aria-hidden="true"></div>
  <Navbar />
  <slot />
  <Footer />

  <script is:inline>
    document.addEventListener('astro:before-preparation', () => {
      const bar = document.querySelector('.global-progress-bar');
      if (bar) {
        bar.style.width = '0%';
        bar.style.opacity = '1';
        bar.getBoundingClientRect();
        bar.style.width = '90%';
        bar.style.transition = 'width 10s cubic-bezier(0.08, 0.82, 0.17, 1)';
      }
    });
    document.addEventListener('astro:after-swap', () => {
      if (location.hash) {
        const el = document.querySelector(location.hash);
        if (el) el.scrollIntoView();
      } else {
        window.scrollTo(0, 0);
      }
    });
    document.addEventListener('astro:page-load', () => {
      const bar = document.querySelector('.global-progress-bar');
      if (bar) {
        bar.style.width = '100%';
        bar.style.transition = 'width 0.2s ease-out';
        setTimeout(() => {
          bar.style.opacity = '0';
          setTimeout(() => {
            bar.style.width = '0%';
          }, 200);
        }, 150);
      }
    });
  </script>
</body>
</html>
